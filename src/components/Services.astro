---

<!-- ============ "What we build" intro ============ -->
<section id="services" class="py-5">
  <div class="site-shell">
    <div class="grid items-center gap-5 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10">
      <div class="reveal flex flex-col justify-center px-1 py-6 lg:px-5">
        <p class="mono text-[--color-acc]">What we build</p>
        <h2 class="display mt-4 text-[clamp(2rem,4vw,3.35rem)]">
          From a single agent to an entire <span class="accent">platform</span>.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-[--color-fg-muted]">
          From AI agents and voice systems to business automation, custom software and SaaS
          platforms - we design and engineer the complex technology growing businesses rely on.
          If you can describe it, we can build it.
        </p>
      </div>

      <div class="reveal relative">
        <div class="pointer-events-none absolute -inset-6 -z-10 bg-[radial-gradient(circle_at_38%_40%,rgba(46,214,255,.22),transparent_62%),radial-gradient(circle_at_64%_74%,rgba(103,92,255,.2),transparent_60%)] blur-2xl"></div>
        <img
          src={spotlightImage}
          alt="AI engineering capabilities - AI Agents, AI Voice Agents, Business Automation, Custom Software, SaaS Platforms and AI solutions that scale"
          width="1268"
          height="1240"
          loading="lazy"
          decoding="async"
          class="relative w-full rounded-[24px]"
        />
      </div>
    </div>
  </div>
</section>

<!-- ============ "We Specialize In" interactive section ============ -->
<section class="spec-section">
  <div class="site-shell">
    <p class="mono text-[--color-acc]">Our services</p>
    <h2 class="spec-title display">We Specialize In</h2>

    <div class="spec-body">
      <!-- Service list -->
      <ul class="spec-services" id="specServices">
        {capabilities.map((c, i) => (
          <li>
            <button
              class:list={["spec-item", { "is-active": i === 0 }]}
              data-index={i}
              type="button"
            >
              <span class="spec-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="spec-text">
                <span class="spec-name">{c.title}</span>
                <span class="spec-desc">{c.desc}</span>
              </span>
              <svg class="spec-arrow" viewBox="0 0 256 256" aria-hidden="true" fill="currentColor">
                <path d="M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z" />
              </svg>
            </button>
          </li>
        ))}
      </ul>

      <!-- Media panel — each service group has multiple stacked images -->
      <div class="spec-media" id="specMedia">
        {capabilities.map((c, gi) => (
          <div
            class:list={["spec-group", { "is-active": gi === 0 }]}
            data-group={gi}
          >
            {c.media.map((src, si) => (
              <img
                src={src}
                alt={`${c.title} ${si + 1}`}
                draggable="false"
                loading={gi === 0 && si === 0 ? "eager" : "lazy"}
                class:list={["spec-frame", { "is-visible": si === 0 }]}
                data-frame={si}
              />
            ))}
            <!-- progress dots -->
            <div class="spec-dots">
              {c.media.map((_, si) => (
                <span class:list={["spec-dot", { "is-current": si === 0 }]} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.bookingUrl} class="btn-primary px-6 py-3.5">
        Book a Free Consultation
        <span aria-hidden="true">→</span>
      </a>
      <a href="#work" class="btn-ghost px-6 py-3.5">Case Studies</a>
    </div>
  </div>
</section>

<style>
  /* ---- We Specialize In section ---- */
  .spec-section {
    padding: 3rem 0;
  }

  .spec-title {
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .spec-body {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 3rem;
    align-items: start;
  }

  .spec-services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spec-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    padding: 0.75rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--color-fg-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.45;
    transition:
      background 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-item.is-active {
    background: linear-gradient(135deg, rgba(103, 92, 255, 0.35), rgba(30, 214, 255, 0.12));
    border-color: rgba(103, 92, 255, 0.4);
    color: var(--color-fg);
    opacity: 1;
  }

  .spec-item:hover:not(.is-active) {
    opacity: 0.7;
    background: rgba(255, 255, 255, 0.03);
  }

  .spec-item:focus-visible {
    outline: 2px solid var(--color-acc);
    outline-offset: 2px;
  }

  .spec-num {
    flex: 0 0 auto;
    padding-top: 4px;
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .spec-item.is-active .spec-num {
    color: var(--color-acc-2);
    opacity: 1;
  }

  .spec-text { flex: 1 1 auto; min-width: 0; }

  .spec-name {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .spec-desc {
    display: block;
    margin-top: 4px;
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  .spec-arrow {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    margin-top: 4px;
    transform: translateX(-6px);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-item.is-active .spec-arrow {
    transform: translateX(0);
    opacity: 1;
    color: #fff;
  }

  /* ---- Media panel ---- */
  .spec-media {
    position: sticky;
    top: 6rem;
    isolation: isolate;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: linear-gradient(145deg, rgba(19, 25, 50, 0.72), rgba(5, 7, 16, 0.72));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 24px 70px rgba(0, 0, 0, 0.38);
    aspect-ratio: 9 / 7.7;
  }

  /* Each service's image group */
  .spec-group {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-group.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Individual frames within a group */
  .spec-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .spec-frame.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* Splash / ripple overlay on frame change */
  .spec-group::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(103, 92, 255, 0.3), rgba(30, 214, 255, 0.15) 40%, transparent 70%);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .spec-group.splash::after {
    opacity: 1;
    transform: scale(1.2);
  }

  /* Progress dots */
  .spec-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 6px;
  }

  .spec-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .spec-dot.is-current {
    background: #fff;
    transform: scale(1.3);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .spec-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .spec-media {
      position: static;
      order: -1;
    }
    .spec-item { padding: 0.85rem 1rem; }
    .spec-name { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spec-item, .spec-arrow, .spec-frame, .spec-group {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
(function () {
  const list  = document.getElementById('specServices');
  const media = document.getElementById('specMedia');
  if (!list || !media) return;

  const items  = list.querySelectorAll('.spec-item');
  const groups = media.querySelectorAll('.spec-group');
  const count  = groups.length;

  let currentGroup = 0;
  let cycleTimer: ReturnType<typeof setInterval> | null = null;
  const CYCLE_MS = 1600; // time between image switches

  function stopCycle() {
    if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = null; }
  }

  function startCycle(groupIndex: number) {
    stopCycle();
    const group = groups[groupIndex];
    const frames = group.querySelectorAll('.spec-frame');
    const dots   = group.querySelectorAll('.spec-dot');
    if (frames.length <= 1) return;

    let activeFrame = 0;

    cycleTimer = setInterval(() => {
      // hide current
      frames[activeFrame].classList.remove('is-visible');
      dots[activeFrame].classList.remove('is-current');

      // advance
      activeFrame = (activeFrame + 1) % frames.length;

      // splash effect
      group.classList.add('splash');
      setTimeout(() => group.classList.remove('splash'), 350);

      // show next
      frames[activeFrame].classList.add('is-visible');
      dots[activeFrame].classList.add('is-current');
    }, CYCLE_MS);
  }

  function activate(index: number) {
    if (index === currentGroup || index < 0 || index >= count) return;

    // reset previous group's frames to first image
    const prevGroup = groups[currentGroup];
    const prevFrames = prevGroup.querySelectorAll('.spec-frame');
    const prevDots   = prevGroup.querySelectorAll('.spec-dot');
    prevFrames.forEach((f, i) => f.classList.toggle('is-visible', i === 0));
    prevDots.forEach((d, i) => d.classList.toggle('is-current', i === 0));

    currentGroup = index;

    // toggle service list active state
    items.forEach((el, i) => el.classList.toggle('is-active', i === index));

    // toggle media group
    groups.forEach((g, i) => g.classList.toggle('is-active', i === index));

    // restart the image cycle for the new group
    startCycle(index);
  }

  items.forEach((el) => {
    const index = parseInt((el as HTMLElement).dataset.index || '0', 10);
    el.addEventListener('mouseenter', () => activate(index));
    el.addEventListener('focus', () => activate(index));
    el.addEventListener('click', (e) => {
      if (window.matchMedia('(hover: none)').matches && currentGroup !== index) {
        e.preventDefault();
        activate(index);
      }
    });
  });

  // start cycling on the first group
  startCycle(0);
})();
</script>
