---
const systems = [
  {
    tag: "SaaS Platform",
    img: "/assets/generated/work-lumen.webp",
    problem: "A founder needed a market-ready, multi-tenant product - fast.",
    system: "Full multi-tenant SaaS: auth, billing, AI features and an admin layer, built from scratch.",
    tools: ["Next.js", "React", "TypeScript", "Node.js", "PostgreSQL", "Prisma", "Stripe", "Redis", "Docker", "Vercel", "TailwindCSS", "GraphQL", "Auth0", "AWS S3"],
    outcome: "Launched to market in a single engagement.",
  },
  {
    tag: "Voice AI System",
    img: "/assets/generated/work-verve.webp",
    problem: "Inbound calls overwhelmed the team, especially after hours.",
    system: "Natural-language voice agent wired directly into the client's CRM and scheduling.",
    tools: ["Twilio", "OpenAI", "ElevenLabs", "Python", "FastAPI", "HubSpot", "Salesforce", "Calendly", "Retell AI", "WebSockets", "GCP", "Firebase", "Whisper AI", "LangChain"],
    outcome: "24/7 inbound handled - zero missed calls.",
  },
  {
    tag: "RAG Knowledge Assistant",
    img: "/assets/generated/work-orion.webp",
    problem: "Staff couldn't find answers buried across thousands of documents.",
    system: "Retrieval engine over enterprise docs returning sourced, accurate answers.",
    tools: ["Pinecone", "OpenAI", "LangChain", "Python", "ChromaDB", "Supabase", "Embeddings", "Claude AI", "Weaviate", "FastAPI", "Next.js", "MongoDB", "AWS Lambda", "Unstructured"],
    outcome: "Accurate answers across 1000s of documents.",
  },
  {
    tag: "Automation Infrastructure",
    img: "/assets/generated/service-v3-business-automation.webp",
    problem: "Manual data entry sprawled across CRMs, ERPs and 200+ tools.",
    system: "Event-driven workflows that move data, assign tasks and trigger actions automatically.",
    tools: ["Make", "Zapier", "n8n", "HubSpot", "Salesforce", "QuickBooks", "Xero", "Slack", "Airtable", "Notion", "Google Sheets", "Webhooks", "REST APIs", "Shopify"],
    outcome: "20–70% reduction in manual operations.",
  },
];
---

<section id="work" class="py-5">
  <div class="site-shell">
    <div class="flex flex-wrap items-end justify-between gap-5 pb-10">
      <div class="max-w-2xl">
        <p class="mono text-[--color-acc]">Our services</p>
        <h2 class="display mt-4 text-[clamp(2rem,4vw,3.2rem)]">We <span class="accent">Specialize In</span></h2>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {systems.map((s) => (
        <article class="soft-card group flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:border-[--color-acc]/40">
          <div class="relative h-44 overflow-hidden">
            <img src={s.img} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover opacity-88 transition duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>
            <div class="absolute left-5 top-4 text-xs font-bold uppercase tracking-[0.16em] text-white">{s.tag}</div>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <div class="grid gap-4 sm:grid-cols-2 min-h-[90px]">
              <div>
                <p class="mono text-[10px] text-white">Problem</p>
                <p class="mt-1.5 text-sm leading-6 text-white/62">{s.problem}</p>
              </div>
              <div>
                <p class="mono text-[10px] text-white">System built</p>
                <p class="mt-1.5 text-sm leading-6 text-white/62">{s.system}</p>
              </div>
            </div>

            <div class="mt-4">
              <p class="mono text-[10px] text-white">Tools used</p>
              <div class="tools-marquee-wrap mt-2">
                <div class="tools-marquee">
                  <div class="tools-marquee-track">
                    {s.tools.map((t) => (
                      <span class="tools-tag">{t}</span>
                    ))}
                    {s.tools.map((t) => (
                      <span class="tools-tag">{t}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4 border-t border-white/8 pt-4">
              <p class="mono text-[10px] text-[--color-acc]">Outcome</p>
              <p class="mt-1.5 text-[15px] font-semibold leading-6 text-white">{s.outcome}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 text-center text-xs text-white/40">Representative systems - named case studies added with approved client assets.</p>
  </div>
</section>

<style>
  .tools-marquee-wrap {
    position: relative;
    overflow: hidden;
  }
  .tools-marquee-wrap::before,
  .tools-marquee-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40px;
    z-index: 2;
    pointer-events: none;
  }
  .tools-marquee-wrap::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg, #060a14), transparent);
  }
  .tools-marquee-wrap::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg, #060a14), transparent);
  }
  .tools-marquee {
    overflow: hidden;
  }
  .tools-marquee-track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    animation: tools-scroll 20s linear infinite;
    animation-play-state: paused;
  }
  .group:hover .tools-marquee-track {
    animation-play-state: running;
  }
  .tools-tag {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.6rem;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
  }
  @keyframes tools-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tools-marquee-track { animation: none; }
  }
</style>
