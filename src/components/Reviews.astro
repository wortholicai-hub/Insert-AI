---
// ⚠️ PLACEHOLDER reviews - swap for real client quotes when you have them.
const reviews = [
  {
    quote: "They scoped the architecture better than our own team could. What they shipped was clean, documented, and genuinely scalable.",
    name: "Daniel Reyes", role: "CTO, NorthPeak SaaS", avatar: null,
  },
  {
    quote: "Their voice agent books appointments while we sleep. We stopped missing after-hours calls completely - it paid for itself in the first month.",
    name: "Sarah Mitchell", role: "Owner, Brightside Dental", avatar: "/avatar-1.webp",
  },
  {
    quote: "We were drowning in manual QuickBooks and HubSpot entry. InsertAI automated all of it. My team got ~20 hours a week back.",
    name: "James Carter", role: "Operations Director, Carter Logistics", avatar: "/avatar-2.webp",
  },
  {
    quote: "Every lead now gets a response in seconds, not hours. Our close rate jumped and we didn't add a single hire.",
    name: "Priya Nair", role: "Founder, LeadForge Marketing", avatar: "/avatar-3.webp",
  },
  {
    quote: "Our internal dashboards finally give us live visibility. Decisions that used to take days now take minutes.",
    name: "Amara Okafor", role: "Head of Ops, Vantage Group", avatar: null,
  },
];

const initials = (name) => name.split(" ").map((p) => p[0]).slice(0, 2).join("");

// The list is rendered twice. The animation travels exactly one list-width and
// then repeats, so the second copy is what occupies the right-hand side at the
// moment the transform snaps back - that is what makes the loop seamless
// rather than visibly jumping. The copy is aria-hidden so screen readers and
// search engines see each quote once.
const marquee = [...reviews, ...reviews];
---

<section id="reviews" class="py-5">
  <div class="site-shell">
    <div class="mx-auto max-w-2xl pb-9 text-center">
      <p class="mono text-[--color-acc]">Reviews</p>
      <h2 class="display mt-4 text-[clamp(2rem,4vw,3.35rem)]">
        What clients <span class="accent">say.</span>
      </h2>
    </div>

    <div class="rv-marquee mx-auto max-w-[86rem]">
      <div class="rv-track">
        {marquee.map((r, i) => (
          <figure class="rv-card" aria-hidden={i >= reviews.length ? "true" : undefined}>
            <p class="rv-stars" aria-label="Rated 5 out of 5">★★★★★</p>
            <blockquote class="rv-quote">{r.quote}</blockquote>
            <figcaption class="rv-by">
              {r.avatar ? (
                <img src={r.avatar} alt="" width="38" height="38" loading="lazy" decoding="async" class="rv-face" />
              ) : (
                <span class="rv-face rv-initials">{initials(r.name)}</span>
              )}
              <div>
                <p class="rv-name">{r.name}</p>
                <p class="rv-role">{r.role}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rv-marquee {
    overflow: hidden;
    /* without the fade, cards are guillotined at the container edge, which
       reads as a clipping bug rather than as motion continuing off-screen */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .rv-track {
    display: flex;
    gap: 1.3rem;
    width: max-content;
    animation: rv-scroll 52s linear infinite;
  }
  /* let someone stop a quote they are halfway through reading */
  .rv-marquee:hover .rv-track { animation-play-state: paused; }

  /* The track is 10 cards and 9 gaps, so one list-width is not -50% - that
     would be 5 cards and 4.5 gaps. The extra half-gap is the correction. */
  @keyframes rv-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 0.65rem)); }
  }

  .rv-card {
    flex: 0 0 22rem;
    display: flex;
    flex-direction: column;
    padding: 1.55rem 1.5rem 1.4rem;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.78), rgba(8, 11, 24, 0.82));
    transition: border-color 0.25s ease;
  }
  .rv-card:hover { border-color: rgba(46, 214, 255, 0.42); }

  .rv-stars {
    font-size: 1.05rem;
    line-height: 1;
    letter-spacing: 0.14em;
    color: #ffc24a;
  }

  .rv-quote {
    margin-top: 0.95rem;
    font-size: 0.95rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.88);
  }

  .rv-by {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    /* pins the byline to the bottom, so it lines up across cards of differing
       quote length instead of floating mid-card */
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-edge);
  }
  .rv-face {
    flex: none;
    height: 38px;
    width: 38px;
    border-radius: 50%;
    object-fit: cover;
  }
  .rv-initials {
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #725eff, #4e73ff 55%, #1ed6ff);
  }
  .rv-name { font-size: 0.83rem; font-weight: 600; color: #fff; }
  .rv-role { margin-top: 0.1rem; font-size: 0.74rem; color: rgba(255, 255, 255, 0.55); }

  @media (max-width: 560px) {
    .rv-card { flex-basis: 18rem; }
  }

  /* drifting text is a vestibular trigger - hand the row over as something
     the visitor scrolls themselves */
  @media (prefers-reduced-motion: reduce) {
    .rv-track { animation: none; }
    .rv-marquee { overflow-x: auto; scrollbar-width: thin; scrollbar-color: #7d5cff transparent; }
  }
</style>
