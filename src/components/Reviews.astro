---
// ⚠️ PLACEHOLDER reviews - swap for real client quotes when you have them.
const reviews = [
  {
    quote: "They scoped the architecture better than our own team could. What they shipped was clean, documented, and genuinely scalable.",
    name: "Daniel Reyes", role: "CTO, NorthPeak SaaS", avatar: null,
  },
  {
    quote: "Their voice agent books appointments while we sleep. We stopped missing after-hours calls completely - it paid for itself in the first month.",
    name: "Sarah Mitchell", role: "Owner, Brightside Dental", avatar: "/avatar-1.webp",
  },
  {
    quote: "We were drowning in manual QuickBooks and HubSpot entry. InsertAI automated all of it. My team got ~20 hours a week back.",
    name: "James Carter", role: "Operations Director, Carter Logistics", avatar: "/avatar-2.webp",
  },
  {
    quote: "Every lead now gets a response in seconds, not hours. Our close rate jumped and we didn't add a single hire.",
    name: "Priya Nair", role: "Founder, LeadForge Marketing", avatar: "/avatar-3.webp",
  },
  {
    quote: "Our internal dashboards finally give us live visibility. Decisions that used to take days now take minutes.",
    name: "Amara Okafor", role: "Head of Ops, Vantage Group", avatar: null,
  },
];

const initials = (name) => name.split(" ").map((p) => p[0]).slice(0, 2).join("");
---

<section id="reviews" class="py-5">
  <div class="site-shell">
    <div class="mx-auto max-w-2xl pb-9 text-center">
      <p class="mono text-[--color-acc]">Reviews</p>
      <h2 class="display mt-4 text-[clamp(2rem,4vw,3.35rem)]">
        What clients <span class="accent">say.</span>
      </h2>
    </div>

    <!--
      A wall, not a carousel. This used to be a max-w-3xl one-at-a-time slider,
      which sat at less than half the width of the booking panel directly above
      it and made the whole foot of the page look misaligned. Showing every
      quote at once also means five proof points land instead of one, and there
      is no auto-advancing timer racing the reader.
    -->
    <div class="rv mx-auto max-w-[86rem]">
      {reviews.map((r) => (
        <figure class="rv-card">
          <p class="rv-stars" aria-label="Rated 5 out of 5">★★★★★</p>
          <blockquote class="rv-quote">{r.quote}</blockquote>
          <figcaption class="rv-by">
            {r.avatar ? (
              <img src={r.avatar} alt="" width="38" height="38" loading="lazy" decoding="async" class="rv-face" />
            ) : (
              <span class="rv-face rv-initials">{initials(r.name)}</span>
            )}
            <div>
              <p class="rv-name">{r.name}</p>
              <p class="rv-role">{r.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Multi-column rather than grid: the quotes differ in length, and columns
     let each card keep its natural height instead of every card in a row
     stretching to match the tallest one. */
  .rv {
    columns: 3;
    column-gap: 1.3rem;
  }

  .rv-card {
    /* without this a card can be split across a column boundary */
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin-bottom: 1.3rem;
    padding: 1.55rem 1.5rem 1.4rem;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.78), rgba(8, 11, 24, 0.82));
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .rv-card:hover {
    border-color: rgba(46, 214, 255, 0.42);
    transform: translateY(-2px);
  }

  .rv-stars {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #ffc24a;
  }

  .rv-quote {
    margin-top: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.88);
  }

  .rv-by {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-edge);
  }
  .rv-face {
    flex: none;
    height: 38px;
    width: 38px;
    border-radius: 50%;
    object-fit: cover;
  }
  .rv-initials {
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #725eff, #4e73ff 55%, #1ed6ff);
  }
  .rv-name { font-size: 0.83rem; font-weight: 600; color: #fff; }
  .rv-role { margin-top: 0.1rem; font-size: 0.74rem; color: rgba(255, 255, 255, 0.55); }

  @media (max-width: 1100px) { .rv { columns: 2; } }
  @media (max-width: 680px) { .rv { columns: 1; } }
</style>
