---
/**
 * Port of the refracting-icosahedron demo.
 *
 * Same technique as the original: a canvas is tiled with repeated text, split
 * into 6 square tiles, loaded as a CubeTexture with CubeRefractionMapping and
 * used as the envMap. The camera trails the pointer and looks at the mesh.
 *
 * Differences from the original, all deliberate:
 *  - monochrome (white type on black) rather than the random colour palette
 *  - MeshBasicMaterial, not Phong - Phong's diffuse term multiplied the envMap
 *    down so the type never reached true white
 *  - subdivided to detail 4 with sphere normals for a round silhouette
 *  - scoped to its container: sized off the parent rather than window.inner*,
 *    renders into its own canvas instead of document.body, no body tinting,
 *    and pauses when scrolled offscreen
 */

interface Props {
  text?: string;
}
const { text = "INSERT AI" } = Astro.props;
---

<div class="orb-scene" data-vision-orb data-text={text} aria-hidden="true">
  <canvas class="orb-canvas"></canvas>
</div>

<style>
  .orb-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* transparent, not #000 - otherwise the canvas paints its own black
       rectangle over the section and the panel is effectively still there */
    background-color: transparent;
  }

  .orb-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import * as THREE from "three";
  import "@fontsource/rubik-mono-one/400.css";

  /* Monochrome: pure white type on a pure black field, so the orb refracts
     as a black hole with "INSERT AI" caught in the facets. */
  const TEXT_COLOR = "#FFFFFF";
  const FIELD_COLOR = "#000000";

  const roots = document.querySelectorAll("[data-vision-orb]");

  roots.forEach((root) => {
    const canvas = root.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const text = root.getAttribute("data-text") || "INSERT AI";

    /* ── textToTexture: the original, retuned for legibility ── */
    const textToTexture = (str) => {
      const canvasEl = document.createElement("canvas");
      const tile_size = 1024;
      /* Small enough that whole "INSERT AI" repetitions fit inside the
         refracted view - at 50px only "INS" was ever visible at once. */
      const fontSize = 14;

      canvasEl.width = tile_size * 4;
      canvasEl.height = tile_size;

      const ctx = canvasEl.getContext("2d");
      ctx.font = fontSize + "px 'Rubik Mono One', Helvetica";

      ctx.fillStyle = FIELD_COLOR;
      ctx.fillRect(0, 0, canvasEl.width, canvasEl.height);

      /* A trailing gap keeps repetitions from running together as
         "...INSERT AIINSERT AI...", which is what lets the eye grab the
         "AI INSERT" boundary instead of the phrase. */
      const label = str + "   ";
      const text_width = ctx.measureText(label).width;
      const text_height = fontSize * 1.7; // was 0.8 - rows overlapped

      ctx.fillStyle = TEXT_COLOR;
      ctx.textBaseline = "top";

      /* The original staggered alternate rows by half a phrase width. Through
         the refraction that lands fragments like "RT A" directly above "INSE",
         which reads back as "AI INSERT". Aligning the columns keeps whole
         phrases stacked so it always reads "INSERT AI". */
      for (let y = 0; y < canvasEl.height; y += text_height) {
        for (let x = 0; x < canvasEl.width; x += text_width) {
          ctx.fillText(label, x, y);
        }
      }

      const tileFromCanvas = (i) => {
        const img_canvas = document.createElement("canvas");
        img_canvas.width = tile_size;
        img_canvas.height = tile_size;
        const context = img_canvas.getContext("2d");
        context.drawImage(canvasEl, -tile_size * i, 0);
        return img_canvas.toDataURL();
      };

      return [
        tileFromCanvas(0),
        tileFromCanvas(1),
        tileFromCanvas(4), // blank_space
        tileFromCanvas(4), // blank_space
        tileFromCanvas(2),
        tileFromCanvas(3),
      ];
    };

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, 1, 1, 10000);
    camera.position.z = -100;
    camera.position.y = -100;

    scene.add(new THREE.AmbientLight(0xffffff));

    /* detail 4 rounds the silhouette off - at detail 1 the outline reads as a
       hard-cornered polygon. */
    const geometry = new THREE.IcosahedronGeometry(50, 4);

    /* PolyhedronGeometry is non-indexed, so computeVertexNormals leaves flat
       per-face normals and the refraction stays faceted no matter how round
       the outline gets. On a sphere the true normal is just the normalised
       position - substituting it gives a smoothly curved refraction. */
    {
      const pos = geometry.attributes.position;
      const normals = new Float32Array(pos.count * 3);
      for (let i = 0; i < pos.count; i += 1) {
        const x = pos.getX(i);
        const y = pos.getY(i);
        const z = pos.getZ(i);
        const len = Math.hypot(x, y, z) || 1;
        normals[i * 3] = x / len;
        normals[i * 3 + 1] = y / len;
        normals[i * 3 + 2] = z / len;
      }
      geometry.setAttribute("normal", new THREE.BufferAttribute(normals, 3));
    }
    /* Unlit: Phong's diffuse term multiplied the envMap down to grey, so the
       type never reached true white. Basic samples the refraction directly. */
    const material = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      refractionRatio: 0.85,
      reflectivity: 1,
    });
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    // render into the scoped canvas rather than appending to document.body
    const gl = renderer.domElement;
    gl.style.width = "100%";
    gl.style.height = "100%";
    gl.style.display = "block";
    canvas.replaceWith(gl);

    let currentTexture = null;
    const applyTexture = (str) => {
      const imgs = textToTexture(str);
      const texture = new THREE.CubeTextureLoader().load(imgs);
      texture.mapping = THREE.CubeRefractionMapping;
      // without this the tiles are read as linear and the type renders grey
      texture.colorSpace = THREE.SRGBColorSpace;
      const previous = currentTexture;
      currentTexture = texture;
      material.envMap = texture;
      material.needsUpdate = true;
      if (previous) previous.dispose();
    };

    // Rubik Mono One must be resident before the tiles are drawn, or the
    // canvas falls back to Helvetica and the tiling metrics shift.
    if (document.fonts && document.fonts.load) {
      document.fonts
        .load("14px 'Rubik Mono One'")
        .then(() => applyTexture(text))
        .catch(() => applyTexture(text));
    } else {
      applyTexture(text);
    }

    /* ── pointer trail, measured against the container ── */
    let mouseX = 0;
    let mouseY = 0;
    const onPointerMove = (event) => {
      const source = event.touches ? event.touches[0] : event;
      const rect = root.getBoundingClientRect();
      mouseX = (source.clientX - (rect.left + rect.width / 2)) / 4;
      mouseY = (source.clientY - (rect.top + rect.height / 2)) / 4;
    };
    root.addEventListener("mousemove", onPointerMove, false);
    root.addEventListener("touchmove", onPointerMove, false);

    /* ── size: larger at rest, a small step up on hover ──
       Kept clear of 1.0 headroom so the sphere never clips the container,
       which has overflow:hidden. */
    const BASE_SCALE = 1.05;
    const HOVER_SCALE = 1.13;
    let targetScale = BASE_SCALE;
    let currentScale = BASE_SCALE;
    mesh.scale.setScalar(BASE_SCALE);

    const onEnter = () => {
      targetScale = HOVER_SCALE;
    };
    const onLeave = () => {
      targetScale = BASE_SCALE;
    };
    root.addEventListener("pointerenter", onEnter);
    root.addEventListener("pointerleave", onLeave);

    let resizeTimer = 0;
    const applySize = () => {
      const rect = root.getBoundingClientRect();
      const width = Math.max(1, Math.round(rect.width));
      const height = Math.max(1, Math.round(rect.height));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applySize, 150);
    };

    let raf = 0;
    let isVisible = true;

    const render = () => {
      camera.position.x += (mouseX - camera.position.x) * 0.05;
      camera.position.y += (-mouseY - camera.position.y) * 0.05;
      camera.lookAt(mesh.position);

      // eased so the hover step reads as a swell rather than a snap
      currentScale += (targetScale - currentScale) * 0.07;
      mesh.scale.setScalar(currentScale);

      renderer.render(scene, camera);
    };

    const animate = () => {
      raf = requestAnimationFrame(animate);
      if (!isVisible) return;
      render();
    };

    const visObserver = new IntersectionObserver(
      (entries) => {
        for (const e of entries) isVisible = e.isIntersecting;
      },
      { rootMargin: "100px" }
    );
    visObserver.observe(root);

    const resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(root);
    applySize();
    animate();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        clearTimeout(resizeTimer);
        visObserver.disconnect();
        resizeObserver.disconnect();
        root.removeEventListener("mousemove", onPointerMove);
        root.removeEventListener("touchmove", onPointerMove);
        root.removeEventListener("pointerenter", onEnter);
        root.removeEventListener("pointerleave", onLeave);
        geometry.dispose();
        material.dispose();
        if (currentTexture) currentTexture.dispose();
        renderer.dispose();
      },
      { once: true }
    );
  });
</script>
