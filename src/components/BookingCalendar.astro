---
/**
 * Live Calendly booking widget (inline embed), inside a branded shell.
 *
 * The times are Calendly's real availability and Confirm books a real meeting -
 * this is the actual scheduler, not a mockup of one.
 *
 * On the design: the account is on Calendly's free tier (`unbranded: false` on
 * the event), so the embed's background_color / text_color / primary_color
 * parameters are ignored and the widget always paints white. It is cross-origin,
 * so no CSS of ours can reach inside it either. Rather than leave a bare white
 * rectangle on a near-black page, the widget sits on a white sheet inside a dark
 * card: the sheet is pure #fff so Calendly's own card melts into it with no
 * seam, and the dark shell, the brand bar and the gradient edge do the styling
 * around it. If the plan is ever upgraded, the colour parameters below start
 * working on their own and the sheet can go.
 *
 * `data-resize="true"` makes widget.js post a `calendly.page_height` message on
 * every step and size the container to match, so a taller step grows the card
 * instead of being clipped inside a fixed-height box.
 *
 * `data-no-blur` matters: the scroll blur-reveal in Base.astro applies a CSS
 * filter, and a filtered ancestor would blur the iframe and create a new
 * containing block over it.
 */
import { site } from "../data/site";

const params = new URLSearchParams({
  hide_gdpr_banner: "1",
  background_color: "ffffff",
  text_color: "1a1a2e",
  primary_color: "5b6cff",
});
const embedUrl = `${site.bookingUrl}?${params.toString()}`;
---

<div class="bk" data-booking data-no-blur>
  <!-- ── what you're booking ─────────────────────────────── -->
  <header class="bk-brand">
    <span class="bk-logo-clip">
      <img
        src="/assets/agency-logo/insert ai logo svg black bk.svg"
        alt="InsertAI"
        width="150"
        height="75"
        class="bk-logo"
      />
    </span>

    <ul class="bk-meta">
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        30 minutes
      </li>
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
        Video call
      </li>
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/></svg>
        Eastern Time (US &amp; Canada)
      </li>
    </ul>
  </header>

  <!-- ── the live calendar ───────────────────────────────── -->
  <div class="bk-sheet">
    <!-- Calendly replaces the inside of this div with its iframe once widget.js runs -->
    <div
      class="calendly-inline-widget bk-embed"
      data-url={embedUrl}
      data-resize="true"
      data-bk-embed
    ></div>

    <!-- Shown until the iframe paints, and left in place if Calendly is blocked -->
    <div class="bk-fallback" data-bk-fallback>
      <span class="bk-spinner" aria-hidden="true"></span>
      <p class="bk-fallback-text" data-bk-fallback-text>Loading the calendar…</p>
      <a class="bk-fallback-link" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
        Open the booking page <span aria-hidden="true">→</span>
      </a>
    </div>

    <noscript>
      <div class="bk-fallback is-static">
        <p class="bk-fallback-text">The calendar needs JavaScript.</p>
        <a class="bk-fallback-link" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
          Open the booking page <span aria-hidden="true">→</span>
        </a>
      </div>
    </noscript>
  </div>
</div>

<style>
  .bk {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.92), rgba(8, 11, 24, 0.96));
    /* the coloured second shadow is what lifts the card off a near-black page;
       a neutral drop shadow alone reads as a flat rectangle here */
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.5), 0 0 100px rgba(114, 94, 255, 0.14);
    padding: 0.9rem;
    overflow: hidden;
  }
  /* gradient hairline along the top edge, picking up the brand ramp */
  .bk::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, #725eff 22%, #2ed6ff 50%, #9b5cff 78%, transparent);
    opacity: 0.8;
  }

  /* ── brand bar ── */
  /* Centred as one group, so the space before the logo and the space after the
     last chip come out equal on their own - no hand-tuned side padding to keep
     in sync. The gap is the only spacing that matters and it is shared by the
     logo-to-chip and chip-to-chip runs. */
  .bk-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.1rem 12rem;
    padding: 0.35rem 0.6rem 0.9rem;
  }

  /* The logo file is a 1500x1500 square whose artwork is a narrow band with a
     lot of empty box above and below it. A fixed-height box with overflow
     hidden crops that dead space, which keeps the bar shallow without the
     negative margins the nav and footer use - those would drag an oversized
     mark up into the heading above. */
  .bk-logo-clip {
    flex: none;
    display: flex;
    align-items: center;
    height: 38px;
    overflow: hidden;
  }
  .bk-logo { height: 124px; width: auto; }

  .bk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  /* double background: the inner one is the pill fill, the outer paints the
     brand ramp in the 1px the padding-box leaves exposed, which gives a
     gradient border without a wrapper element */
  .bk-meta li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background:
      linear-gradient(rgba(16, 21, 44, 0.96), rgba(16, 21, 44, 0.96)) padding-box,
      linear-gradient(135deg, rgba(114, 94, 255, 0.55), rgba(46, 214, 255, 0.42)) border-box;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.78);
    white-space: nowrap;
  }
  .bk-meta svg { flex: none; color: var(--color-acc); }

  /* ── the white sheet the embed sits on ── */
  /* #fff exactly, not an off-white: Calendly's own card is pure white, and any
     other value leaves a visible rectangle where the card ends and the sheet
     begins. The transparent gutters Calendly leaves around its card become
     sheet padding, which is why no negative margin is needed to close them. */
  .bk-sheet {
    position: relative;
    border-radius: 16px;
    background: #fff;
    overflow: hidden;
  }

  .bk-embed {
    min-width: 320px;
    min-height: 700px;
  }
  /* Calendly injects the iframe as a child of .bk-embed */
  .bk :global(.bk-embed iframe) {
    display: block;
    width: 100%;
    border: 0;
  }

  /* ── loading / blocked state ── */
  .bk-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: 2rem 1.5rem;
    /* matches the sheet, so the spinner sits on white rather than punching a
       dark hole in it */
    background: #fff;
    transition: opacity 0.35s ease;
  }
  .bk-fallback.is-static { position: static; min-height: 22rem; }
  .bk-fallback.is-gone { opacity: 0; pointer-events: none; }

  .bk-spinner {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid rgba(26, 26, 46, 0.14);
    border-top-color: #5b6cff;
    animation: bk-spin 0.8s linear infinite;
  }
  @keyframes bk-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .bk-spinner { animation-duration: 2.4s; }
  }
  .bk-fallback.is-failed .bk-spinner { display: none; }

  .bk-fallback-text {
    font-size: 0.88rem;
    color: rgba(26, 26, 46, 0.6);
  }

  /* only offered once loading has clearly failed - otherwise it competes with
     the calendar that is about to appear underneath it */
  .bk-fallback-link {
    display: none;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.68rem 1.3rem;
    font-size: 0.85rem;
    font-weight: 620;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    box-shadow: 0 10px 24px rgba(85, 94, 255, 0.32);
    transition: transform 0.2s ease;
  }
  .bk-fallback-link:hover { transform: translateY(-1px); }
  .bk-fallback.is-failed .bk-fallback-link,
  .bk-fallback.is-static .bk-fallback-link { display: inline-flex; }

  @media (max-width: 860px) {
    .bk { padding: 0.6rem; border-radius: 20px; }
    .bk-brand { padding: 0.3rem 0.35rem 0.75rem; gap: 0.5rem 0.75rem; }
    .bk-logo-clip { height: 32px; }
    .bk-logo { height: 104px; }
    .bk-meta li { font-size: 0.75rem; padding: 0.4rem 0.7rem; }
    /* Calendly's stacked layout needs the extra room before its first resize
       message arrives */
    .bk-embed { min-height: 1000px; }
  }
</style>

<script>
  document.querySelectorAll("[data-booking]").forEach((root) => {
    const el = root as HTMLElement;
    const embed = el.querySelector("[data-bk-embed]") as HTMLElement | null;
    const fallback = el.querySelector("[data-bk-fallback]") as HTMLElement | null;
    const fallbackText = el.querySelector("[data-bk-fallback-text]") as HTMLElement | null;
    if (!embed || !fallback) return;

    let settled = false;
    const done = () => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      fallback.classList.add("is-gone");
    };
    const failed = (msg: string) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      fallback.classList.add("is-failed");
      if (fallbackText) fallbackText.textContent = msg;
    };

    // If Calendly is blocked by an extension or the network, stop spinning and
    // hand the visitor the plain link rather than an empty card.
    const timer = setTimeout(
      () => failed("The calendar could not load here."),
      10000
    );

    // Calendly builds the iframe asynchronously after widget.js runs, so watch
    // for it rather than assuming it exists once the script has loaded.
    const adopt = (frame: HTMLIFrameElement) => {
      watch.disconnect();
      frame.addEventListener("load", done, { once: true });
      // already painted from cache - the load event would never fire again
      if (frame.contentWindow) setTimeout(done, 1200);
    };
    const watch = new MutationObserver(() => {
      const frame = embed.querySelector("iframe");
      if (frame) adopt(frame);
    });
    watch.observe(embed, { childList: true, subtree: true });

    // covers the case where widget.js was already on the page and had filled
    // this embed in before we started observing
    const present = embed.querySelector("iframe");
    if (present) adopt(present);

    // The embed reports its own height as the visitor moves through the steps;
    // treat the first report as "it is alive" too, in case the iframe load
    // event is swallowed.
    window.addEventListener("message", (e: MessageEvent) => {
      if (e.data?.event === "calendly.page_height") done();
    });

    // Load widget.js once per page, even if the component appears twice.
    const SRC = "https://assets.calendly.com/assets/external/widget.js";
    const existing = document.querySelector(`script[src="${SRC}"]`);
    if (!existing) {
      const s = document.createElement("script");
      s.src = SRC;
      s.async = true;
      s.addEventListener("error", () =>
        failed("The calendar could not load here.")
      );
      document.head.appendChild(s);
    }
  });
</script>
