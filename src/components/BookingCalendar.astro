---
/**
 * Calendly-style booking widget: meeting details, month grid, time column.
 *
 * This is a MOCKUP of the availability only. `isOpen()` / `slotsFor()` below
 * generate a deterministic pattern so the grid looks alive without a backend.
 *
 * TO GO LIVE WITH CAL.COM / CALENDLY there are two options and neither
 * touches the markup:
 *   1. Keep this UI and replace those two functions with a free-busy fetch.
 *   2. Drop the real embed in and delete this component - the confirm button
 *      already hands off to `site.bookingUrl` with ?month= and &date=, which
 *      is the query shape both Calendly and Cal.com use to deep-link a day.
 */
import { site } from "../data/site";
---

<div class="bk" data-booking data-booking-url={site.bookingUrl} data-no-blur>
  <!-- ── what you're booking ─────────────────────────────── -->
  <aside class="bk-info">
    <img src="/assets/agency-logo/insert ai logo svg black bk.svg" alt="InsertAI" width="150" height="75" class="bk-logo" />
    <p class="bk-kicker">Architecture review</p>
    <h3 class="bk-title">Talk to an engineer</h3>

    <ul class="bk-meta">
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        30 minutes
      </li>
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
        Video call
      </li>
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/></svg>
        <span>Eastern Time (US &amp; Canada)</span>
      </li>
    </ul>
  </aside>

  <!-- ── month grid ──────────────────────────────────────── -->
  <div class="bk-cal">
    <div class="bk-head">
      <p class="bk-month" data-bk-month aria-live="polite">—</p>
      <div class="bk-navs">
        <button type="button" class="bk-nav" data-bk-prev aria-label="Previous month">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="bk-nav" data-bk-next aria-label="Next month">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="bk-dow" aria-hidden="true">
      <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
    </div>

    <div class="bk-grid" data-bk-grid role="grid" aria-label="Available dates"></div>
  </div>

  <!-- ── times for the chosen day ────────────────────────── -->
  <div class="bk-times">
    <p class="bk-times-head" data-bk-day>Select a day</p>
    <div class="bk-slots" data-bk-slots></div>
    <a class="bk-confirm is-off" data-bk-confirm href={site.bookingUrl} aria-disabled="true">
      Confirm <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .bk {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 13rem;
    gap: 0;
    border-radius: 20px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.9), rgba(8, 11, 24, 0.94));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  /* ── info pane ── */
  .bk-info {
    padding: 1.7rem 1.5rem;
    border-right: 1px solid var(--color-edge);
    background: rgba(255, 255, 255, 0.015);
  }
  /* 100px to match the nav mark. The source SVG carries a lot of internal
     padding, so like the nav (-my-9) the negative margins claw back the empty
     box around the artwork - without them the logo pushes the kicker down and
     the pane looks top-heavy. Scaled from the old 62px values. */
  .bk-logo { height: 100px; width: auto; margin: -23px 0 -12px -10px; }
  .bk-kicker {
    margin-top: 0.2rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-acc);
  }
  .bk-title {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .bk-meta {
    margin-top: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bk-meta li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .bk-meta svg { flex: none; color: var(--color-acc); }

  /* ── calendar pane ── */
  .bk-cal { padding: 1.9rem 2rem; }
  .bk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .bk-month {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .bk-navs { display: flex; gap: 0.4rem; }
  .bk-nav {
    display: grid;
    place-items: center;
    height: 32px;
    width: 32px;
    border-radius: 9px;
    border: 1px solid var(--color-line-strong);
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .bk-nav:hover:not(:disabled) { border-color: var(--color-acc); color: #fff; }
  .bk-nav:disabled { opacity: 0.28; cursor: default; }

  /* full-bleed across the calendar column. The cells are deliberately wider
     than they are tall - at 1fr x 7 a square cell would be ~100px and read as
     a wall-planner, which is why this used to be capped at 25rem. Fixing the
     height instead keeps the widget proportions while letting the calendar
     fill the space. */
  .bk-dow, .bk-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }
  .bk-dow span {
    padding-bottom: 0.6rem;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.34);
  }

  /* :global() is required, not stylistic: the day cells and slot pills are
     built with createElement in the script below, so they never receive
     Astro's scoped data-astro-cid attribute and unscoped selectors would not
     match them. Nesting under .bk keeps them from leaking out of here. */
  .bk :global(.bk-day) {
    min-height: 3.4rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    border: 1px solid rgba(46, 214, 255, 0.22);
    background: rgba(46, 214, 255, 0.08);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.95rem;
    font-weight: 550;
    cursor: pointer;
    transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }
  .bk :global(.bk-day.is-empty) { background: none; border-color: transparent; cursor: default; }
  .bk :global(.bk-day:disabled) {
    background: none;
    border-color: transparent;
    color: rgba(255, 255, 255, 0.16);
    cursor: default;
  }
  .bk :global(.bk-day:hover:not(:disabled):not(.is-on)) {
    border-color: rgba(46, 214, 255, 0.6);
    color: #fff;
    transform: translateY(-1px);
  }
  .bk :global(.bk-day.is-on) {
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    border-color: transparent;
    color: #fff;
  }
  /* the dot is what makes a bookable day readable at a glance on mobile,
     where the tint alone is easy to miss */
  /* bottom-anchored rather than offset by margin: the cell height is no longer
     tied to its width, so a fixed offset from the centre would drift */
  .bk :global(.bk-day.is-free)::after {
    content: "";
    position: absolute;
    bottom: 7px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-acc);
  }
  .bk :global(.bk-day) { position: relative; }
  .bk :global(.bk-day.is-on)::after { background: #fff; }

  /* ── times pane ── */
  .bk-times {
    display: flex;
    flex-direction: column;
    padding: 1.7rem 1.4rem;
    border-left: 1px solid var(--color-edge);
    background: rgba(255, 255, 255, 0.015);
  }
  .bk-times-head {
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.005em;
  }
  .bk-slots {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.9rem 0 1rem;
    /* capped so a busy day scrolls its own column instead of stretching the
       whole card past the calendar next to it */
    max-height: 22rem;
    overflow-y: auto;
    /* Firefox + Chrome 121+. The track is transparent rather than tinted so
       only the thumb is ever visible against the panel. */
    scrollbar-width: thin;
    scrollbar-color: #7d5cff transparent;
    /* fade the bottom edge: without it the slot sitting on the max-height
       boundary looks like a clipped, broken pill rather than a hint that the
       column scrolls */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.6rem), transparent);
  }
  /* older WebKit ignores scrollbar-color, so the grey default would survive
     there without these */
  .bk-slots::-webkit-scrollbar { width: 5px; }
  .bk-slots::-webkit-scrollbar-track { background: transparent; }
  .bk-slots::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: linear-gradient(180deg, #725eff, #9b5cff);
  }
  .bk-slots::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #8a76ff, #b177ff);
  }

  .bk :global(.bk-slot) {
    padding: 0.55rem 0.5rem;
    border-radius: 9px;
    border: 1px solid var(--color-line-strong);
    background: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.82rem;
    font-weight: 550;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.16s ease, color 0.16s ease, background 0.16s ease;
  }
  .bk :global(.bk-slot:hover) { border-color: var(--color-acc); color: #fff; }
  .bk :global(.bk-slot.is-on) {
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    border-color: transparent;
    color: #fff;
  }
  .bk :global(.bk-hint) {
    font-size: 0.78rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.38);
  }

  .bk-confirm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.68rem 1rem;
    font-size: 0.85rem;
    font-weight: 620;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    box-shadow: 0 10px 24px rgba(85, 94, 255, 0.32);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .bk-confirm:hover:not(.is-off) { transform: translateY(-1px); }
  .bk-confirm.is-off { opacity: 0.32; pointer-events: none; }

  @media (max-width: 960px) {
    .bk { grid-template-columns: 1fr; }
    .bk-info { border-right: 0; border-bottom: 1px solid var(--color-edge); }
    .bk-times { border-left: 0; border-top: 1px solid var(--color-edge); }
    .bk-slots { max-height: none; }
    /* side by side once stacked, so a day with many times does not become a
       long vertical list the visitor has to scroll past */
    .bk :global(.bk-slot) { flex: none; }
    .bk-slots { flex-direction: row; flex-wrap: wrap; }
    .bk :global(.bk-slot) { min-width: 5.2rem; flex: 1 1 5.2rem; }
  }
  @media (max-width: 560px) {
    .bk-cal, .bk-info, .bk-times { padding: 1.2rem 1rem; }
    .bk-dow, .bk-grid { gap: 4px; }
    .bk :global(.bk-day) { min-height: 2.6rem; font-size: 0.85rem; border-radius: 8px; }
    .bk :global(.bk-day.is-free)::after { bottom: 5px; }
  }
</style>

<script>
  document.querySelectorAll("[data-booking]").forEach((root) => {
    const el = root as HTMLElement;
    const monthEl = el.querySelector("[data-bk-month]") as HTMLElement;
    const gridEl = el.querySelector("[data-bk-grid]") as HTMLElement;
    const slotsEl = el.querySelector("[data-bk-slots]") as HTMLElement;
    const dayEl = el.querySelector("[data-bk-day]") as HTMLElement;
    const confirmEl = el.querySelector("[data-bk-confirm]") as HTMLAnchorElement;
    const prevBtn = el.querySelector("[data-bk-prev]") as HTMLButtonElement;
    const nextBtn = el.querySelector("[data-bk-next]") as HTMLButtonElement;
    if (!monthEl || !gridEl || !slotsEl) return;

    const bookingUrl = el.dataset.bookingUrl || "#";

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const dayKey = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

    const hash = (s: string) => {
      let h = 2166136261;
      for (let i = 0; i < s.length; i += 1) {
        h ^= s.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return Math.abs(h);
    };

    // ── MOCK AVAILABILITY - replace these two with a real free-busy call ──
    // Slot labels are Eastern Time wall-clock (9:00am-4:30pm ET), which is what
    // the info pane advertises. They are not converted to the visitor's zone,
    // so if this ever renders in local time the pane's label must change too.
    const isOpen = (d: Date) => {
      if (d < today) return false;
      const dow = d.getDay();
      if (dow === 0 || dow === 6) return false;
      return hash(dayKey(d)) % 11 !== 0;
    };

    const slotsFor = (d: Date) => {
      const key = dayKey(d);
      const out: string[] = [];
      for (let i = 0; i < 16; i += 1) {
        if (hash(`${key}:${i}`) % 10 < 4) continue;
        const mins = 9 * 60 + i * 30;
        const h24 = Math.floor(mins / 60);
        const m = mins % 60;
        const ampm = h24 >= 12 ? "pm" : "am";
        const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
        out.push(`${h12}:${String(m).padStart(2, "0")} ${ampm}`);
      }
      return out;
    };
    // ─────────────────────────────────────────────────────────────────────

    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    let selected: Date | null = null;
    let slot: string | null = null;

    const monthFmt = new Intl.DateTimeFormat(undefined, { month: "long", year: "numeric" });
    const dayFmt = new Intl.DateTimeFormat(undefined, { weekday: "long", month: "short", day: "numeric" });

    const syncConfirm = () => {
      const ready = Boolean(selected && slot);
      confirmEl.classList.toggle("is-off", !ready);
      confirmEl.setAttribute("aria-disabled", String(!ready));
      if (!ready || !selected) {
        confirmEl.href = bookingUrl;
        return;
      }
      // ?month=&date= is the deep-link shape Calendly and Cal.com both accept,
      // so swapping bookingUrl for the real link is the whole integration.
      const key = dayKey(selected);
      const sep = bookingUrl.includes("?") ? "&" : "?";
      confirmEl.href = `${bookingUrl}${sep}month=${key.slice(0, 7)}&date=${key}`;
    };

    const renderSlots = () => {
      slotsEl.innerHTML = "";
      if (!selected) {
        dayEl.textContent = "Select a day";
        const p = document.createElement("p");
        p.className = "bk-hint";
        p.textContent = "Pick a highlighted date to see the times open that day.";
        slotsEl.appendChild(p);
        syncConfirm();
        return;
      }

      dayEl.textContent = dayFmt.format(selected);
      const times = slotsFor(selected);
      if (!times.length) {
        const p = document.createElement("p");
        p.className = "bk-hint";
        p.textContent = "Fully booked - try another day.";
        slotsEl.appendChild(p);
        syncConfirm();
        return;
      }

      for (const t of times) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "bk-slot" + (slot === t ? " is-on" : "");
        b.textContent = t;
        b.addEventListener("click", () => {
          slot = t;
          renderSlots();
        });
        slotsEl.appendChild(b);
      }
      syncConfirm();
    };

    const render = () => {
      monthEl.textContent = monthFmt.format(view);

      const atStart =
        view.getFullYear() === today.getFullYear() && view.getMonth() === today.getMonth();
      if (prevBtn) prevBtn.disabled = atStart;

      gridEl.innerHTML = "";
      const first = new Date(view.getFullYear(), view.getMonth(), 1);
      const lead = (first.getDay() + 6) % 7; // Monday-first; getDay() is Sunday-first
      const daysInMonth = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();

      for (let i = 0; i < lead; i += 1) {
        const s = document.createElement("span");
        s.className = "bk-day is-empty";
        gridEl.appendChild(s);
      }

      for (let d = 1; d <= daysInMonth; d += 1) {
        const date = new Date(view.getFullYear(), view.getMonth(), d);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "bk-day";
        btn.textContent = String(d);
        const open = isOpen(date);
        btn.disabled = !open;
        if (open) {
          btn.classList.add("is-free");
          btn.setAttribute("aria-label", dayFmt.format(date));
          btn.addEventListener("click", () => {
            selected = date;
            slot = null;
            render();
          });
        }
        if (selected && dayKey(selected) === dayKey(date)) btn.classList.add("is-on");
        gridEl.appendChild(btn);
      }

      renderSlots();
    };

    prevBtn?.addEventListener("click", () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      render();
    });
    nextBtn?.addEventListener("click", () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      render();
    });

    render();
  });
</script>
