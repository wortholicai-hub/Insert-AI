---
import { site } from "../data/site";
---

<section id="vision" class="py-5">
  <div class="site-shell">
    <div class="grid items-stretch gap-5 lg:grid-cols-[1.08fr_0.92fr] lg:gap-8">
      <!-- statement -->
      <div class="reveal flex flex-col justify-center px-1 py-6 lg:order-2 lg:px-5">
        <p class="mono text-[--color-acc]">Engineered intelligence</p>
        <h2 class="display mt-4 text-[clamp(2rem,4vw,3.35rem)]">
          Where human ambition meets <span class="accent">machine intelligence</span>.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-[--color-fg-muted]">
          The difference between software made with AI and software built to last was never the model.
          It's whether the people building it have shipped real systems into real production and know
          where things quietly break. We have. So what we deliver holds up under load, under users,
          and over time.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="vision-tag">Production-Grade AI</span>
          <span class="vision-tag vision-tag--solid">Battle-Tested Systems</span>
          <span class="vision-tag">Enterprise Scale</span>
        </div>
      </div>

      <!-- full-image card -->
      <div class="reveal relative lg:order-1">
        <!-- ambient glow bleeding behind the card -->
        <div class="pointer-events-none absolute -inset-6 -z-10 bg-[radial-gradient(circle_at_62%_38%,rgba(46,214,255,.24),transparent_62%),radial-gradient(circle_at_36%_74%,rgba(103,92,255,.22),transparent_60%)] blur-2xl"></div>

        <div class="relative h-full min-h-[340px] overflow-hidden rounded-[26px] border border-white/12 shadow-2xl shadow-black/55 sm:min-h-[420px] lg:min-h-[520px]">
          <img
            src="/assets/generated/astronaut.webp"
            alt="Cybernetic astronaut gazing into deep space - human ambition meets machine intelligence"
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
          <!-- bottom depth gradient -->
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/45 via-black/10 to-transparent"></div>
          <!-- inner sheen ring -->
          <div class="pointer-events-none absolute inset-0 rounded-[26px] ring-1 ring-inset ring-white/10"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vision-tag {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease, background 0.2s ease;
  }

  .vision-tag:hover {
    transform: translateY(-2px);
    filter: brightness(1.2);
    box-shadow: 0 8px 20px rgba(85, 94, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
  }

  .vision-tag--solid {
    border: none;
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    color: white;
    box-shadow: 0 8px 20px rgba(85, 94, 255, 0.3);
  }

  .vision-tag--solid:hover {
    filter: saturate(1.12);
    box-shadow: 0 12px 28px rgba(85, 94, 255, 0.48);
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
  }
</style>
