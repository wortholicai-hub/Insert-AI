---
import { site } from "../data/site";
import VisionOrb from "./VisionOrb.astro";
---

<section id="vision" class="py-5">
  <div class="site-shell">
    <div class="grid items-stretch gap-5 lg:grid-cols-[1.08fr_0.92fr] lg:gap-8">
      <!-- statement -->
      <div class="reveal flex flex-col justify-center px-1 py-6 lg:order-2 lg:px-5">
        <p class="mono text-[--color-acc]">Engineered intelligence</p>
        <h2 class="display mt-4 text-[clamp(2rem,4vw,3.35rem)]">
          Where human ambition meets <span class="accent">machine intelligence</span>.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-[--color-fg-muted]">
          The difference between software made with AI and software built to last was never the model.
          It's whether the people building it have shipped real systems into real production and know
          where things quietly break. We have. So what we deliver holds up under load, under users,
          and over time.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="vision-tag">Production-Grade AI</span>
          <span class="vision-tag vision-tag--solid">Battle-Tested Systems</span>
          <span class="vision-tag">Enterprise Scale</span>
        </div>
      </div>

      <!-- orb, sitting straight on the section background - no card -->
      <div class="reveal relative lg:order-1">
        <div class="relative h-full min-h-[340px] sm:min-h-[420px] lg:min-h-[520px]">
          <VisionOrb text="INSERT AI" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vision-tag {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid rgba(78, 115, 255, 0.3);
    background: rgba(78, 115, 255, 0.12);
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(180, 200, 255, 0.8);
    cursor: pointer;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(78, 115, 255, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vision-tag:hover {
    transform: translateY(-2px);
    border-color: transparent;
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    color: white;
    box-shadow: 0 12px 28px rgba(85, 94, 255, 0.48);
    backdrop-filter: none;
  }

  .vision-tag--solid {
    border-color: transparent;
    background: linear-gradient(135deg, #725eff, #4e73ff 52%, #9b5cff);
    color: white;
    box-shadow: 0 8px 20px rgba(85, 94, 255, 0.3);
    backdrop-filter: none;
  }
</style>
