---
import fs from "node:fs";
import { logoGroups } from "../data/logos";

/* Slug -> filename, so a brand can ship either format.

   Everything here is an SVG lifted from simple-icons, but that package carries
   no icon for several major CRMs - Salesforce, Pipedrive, GoHighLevel, Klaviyo,
   Monday.com and others were withdrawn from it - so those have to come from the
   vendor direct, and what the vendor publishes is not always a vector. SVG wins
   when a brand has both. */
const listLogos = (dir) => {
  const map = new Map();
  if (!fs.existsSync(dir)) return map;
  for (const f of fs.readdirSync(dir)) {
    const m = /^(.+)\.(svg|png)$/.exec(f);
    if (!m) continue;
    if (m[2] === "svg" || !map.has(m[1])) map.set(m[1], f);
  }
  return map;
};
const colorFiles = listLogos("public/assets/logos-color");
const colorFor = (slug) =>
  colorFiles.has(slug) ? `/assets/logos-color/${colorFiles.get(slug)}` : undefined;

// Layout lives in a 900x720 viewBox that shares the hub container's aspect
// ratio (uniform scale). Cards are placed by %, and each wire is an orthogonal
// path with rounded bends that docks at the centre of the card's facing border.
const positions = [
  { left: 50.00, top: 9.72 },  // top
  { left: 77.91, top: 29.86 }, // upper-right
  { left: 22.09, top: 29.86 }, // upper-left
  { left: 77.91, top: 70.14 }, // lower-right
  { left: 22.09, top: 70.14 }, // lower-left
  { left: 50.00, top: 90.28 }, // bottom
];

/* All six cards sit on a circle of radius 290 around the hub at (450,360),
   spaced every 60 degrees, so every card centre is exactly equidistant from
   it. The viewBox is 900x720 because the old 582 height capped the radius at
   ~248 and left the cards crowding the hub.

   Every wire is a straight radial spoke that starts at the hub's exact centre
   and runs outward to its card. The previous routing was orthogonal L-routes
   leaving six separate points along the pill's top and bottom edges - which
   meant the four diagonal wires set off vertically and only turned toward
   their card halfway there. Extend one of those back and it pointed at the
   pill's shoulder, not at the middle, and the corner cards read as wired to
   the side of the hub rather than to its heart.

   Starting at the centre rather than at the pill's edge is deliberate: the
   pill sits above the SVG (z-index 2), so it hides the first ~40-64 units of
   every spoke and the comets appear to surface from underneath the mark. That
   is what sells the traffic as originating in the hub.

   Every wire opens with a straight run along that radial line, so it sets off
   pointing out of the centre, then turns twice on its way to the card. The
   turns are what stop it reading as a plain spoke: each wire strikes out from
   the middle, breaks, tracks across, and comes into its card from a side.

   The routes are deliberately not six copies of one shape - they turn at
   different distances and dock at different points along their card's facing
   edge, so the ring does not look mirrored. Corners are rounded by roundedPath
   below, which keeps the breaks crisp rather than curved. */
const HUB = [450, 360];

/* Unit vectors on the 60-degree ring, in wire order: top, upper-right,
   upper-left, lower-right, lower-left, bottom. */
const DIRS = [
  [0, -1],
  [0.86581, -0.50017],
  [-0.86581, -0.50017],
  [0.86581, 0.50017],
  [-0.86581, 0.50017],
  [0, 1],
];
/* a point r units out from the hub along wire i's radial - the opening run */
const out = (i, r) => [
  +(HUB[0] + DIRS[i][0] * r).toFixed(1),
  +(HUB[1] + DIRS[i][1] * r).toFixed(1),
];

/* Wires end a little way INSIDE their card, not on its edge.

   A card is 160x77 CSS px, which is 185x89 viewBox units at the container's
   780px maximum - so its edges sit 92 out horizontally but only 45 vertically.
   Docking the top and bottom wires at 133 and 587 assumed the same 63 as the
   sides and left both of them 18 units short, which is the gap between the
   line and the box.

   Rather than pin the ends to a measurement that moves, every wire now
   overshoots into its card, which sits above the SVG (z-index 3) and hides the
   overlap. The join closes itself: the card always covers the surplus, and it
   covers more of it as the container narrows and the fixed-px cards grow
   against the scaling viewBox. */
const wires = [
  [HUB, out(0, 110), [520, 250], [520, 104]], // top: out, right, up under the card
  [HUB, out(1, 145), [575.5, 215], [623, 215]], // upper-right: out, up, right into the flank
  [HUB, out(2, 145), [324.5, 178], [277, 178]], // upper-left: turns higher than its mirror
  [HUB, out(3, 145), [575.5, 540], [623, 540]], // lower-right: docks low on the flank
  [HUB, out(4, 145), [324.5, 505], [277, 505]], // lower-left
  [HUB, out(5, 110), [378, 470], [378, 616]], // bottom: out, left, down under the card
];

// Build an SVG path of straight segments with rounded corners at the bends.
function roundedPath(pts, r) {
  const dist = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]) || 1;
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const p0 = pts[i - 1], p1 = pts[i], p2 = pts[i + 1];
    const d1 = dist(p0, p1), d2 = dist(p1, p2);
    const rr = Math.min(r, d1 / 2, d2 / 2);
    const ax = p1[0] + ((p0[0] - p1[0]) / d1) * rr;
    const ay = p1[1] + ((p0[1] - p1[1]) / d1) * rr;
    const bx = p1[0] + ((p2[0] - p1[0]) / d2) * rr;
    const by = p1[1] + ((p2[1] - p1[1]) / d2) * rr;
    d += ` L${ax.toFixed(1)} ${ay.toFixed(1)} Q${p1[0]} ${p1[1]} ${bx.toFixed(1)} ${by.toFixed(1)}`;
  }
  const l = pts[pts.length - 1];
  d += ` L${l[0]} ${l[1]}`;
  return d;
}

const paths = wires.map((w) => roundedPath(w, 20));

/* One offset per wire inside the 9s cycle.

   These used to fire in two blocks - the three upper wires together, then the
   three lower - which read as a machine sweeping the ring rather than traffic
   moving through a hub. The offsets below are deliberately uneven (gaps of
   1.15, 1.45, 1.3, 1.7, 1.5) and they alternate between an upper and a lower
   wire, so no two neighbours ever light together and the eye cannot lock onto
   a pattern. Index order is: top, upper-right, upper-left, lower-right,
   lower-left, bottom - so the firing order is top, lower-right, upper-left,
   bottom, upper-right, lower-left.

   Fixed rather than randomised: the server renders these into inline styles,
   so a random draw would differ between the build and any rehydration, and
   would also change on every deploy for no reason. */
const CYCLE = 9;
const WIRE_DELAY = [0, 5.6, 2.6, 1.15, 7.1, 3.9];
const delayFor = (i) => WIRE_DELAY[i];

/* When the charge actually reaches the card, derived from the dash rather than
   guessed - the card must light on contact or the glow reads as decoration
   running on its own timer.

   hub-flow drives stroke-dashoffset from 58 to -158 across the first 45% of
   the cycle, against a "58 200" dash on a path normalised to pathLength 100.
   The lit segment covers path positions -offset to -offset+58, so its leading
   edge touches the far end (100) when the offset passes 58-100 = -42. That is
   (58 - -42) / (58 - -158) = 46.3% of the way through the travel phase.

   The previous value was CYCLE * 0.45 - the moment the dash finishes leaving
   the far end, not the moment it arrives - so every card lit about 2.2s after
   its own current had already gone through, which is why they looked like they
   were glowing at random. */
const TRAVEL = 0.45;
const DASH = 58, OFFSET_FROM = 58, OFFSET_TO = -158;
const ARRIVE =
  CYCLE * TRAVEL * ((OFFSET_FROM - (DASH - 100)) / (OFFSET_FROM - OFFSET_TO));
const glowDelayFor = (i) => +(((WIRE_DELAY[i] + ARRIVE) % CYCLE).toFixed(2));

// Popup placement per ring position. The top row opens downwards and the
// bottom row upwards so the panel always unfolds towards the middle of the
// hub; side cards anchor to their outer edge so a ~300px panel cannot push
// past the container.
const popSides = ["down-center", "down-right", "down-left", "up-right", "up-left", "up-center"];

// filter(Boolean) is the no-placeholder guarantee: a tool whose SVG is missing
// from logos-color drops out of both the card and the popup entirely, rather
// than rendering an empty box or a generic glyph.
const groupNodes = logoGroups.map((g, i) => {
  const all = g.items
    .map((it) => ({ name: it.name, src: colorFor(it.slug) }))
    .filter((it) => it.src);
  return {
    label: g.label,
    all,
    icons: all.slice(0, 3),
    more: Math.max(0, all.length - 3),
    side: popSides[i],
    ...positions[i],
  };
});
---

<!-- The hub used to be aria-hidden wholesale; now that the cards expose a real
     tool list on hover/focus it carries content, and a focusable popup trigger
     inside an aria-hidden subtree is invalid. The purely decorative wires keep
     their own aria-hidden instead. -->
<div class="int-hub">
      <svg class="int-hub-wires" viewBox="0 0 900 720" fill="none" aria-hidden="true">
        <defs>
          <!-- userSpaceOnUse, not the default objectBoundingBox: a perfectly
               vertical path has a zero-width bounding box, which collapses an
               objectBoundingBox gradient and renders the stroke invisible.
               That is why the top and bottom wires vanished while the diagonals
               drew fine. Fixed coordinates over the viewBox avoid it. -->
          <linearGradient id="hubwire" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="900" y2="720">
            <stop offset="0" stop-color="#1ed6ff" />
            <stop offset="1" stop-color="#7b5cff" />
          </linearGradient>
          <!-- the bleed that makes the charge read as current rather than a
               coloured dash. Blur only: the sharp copy is drawn separately on
               top, so this stays a pure halo. -->
          <filter id="hubglow" x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur stdDeviation="5" />
          </filter>
        </defs>

        <!-- the conductor: always drawn, barely lit, so the route exists
             between pulses instead of the charge crossing empty space -->
        <g class="int-hub-rail" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round">
          {paths.map((d) => <path d={d} />)}
        </g>

        <!-- halo and filament share one dash pattern, one animation and one
             delay, so they travel locked together and read as a single charge
             with a bright centre rather than two passes -->
        <g class="int-hub-flow int-hub-halo" filter="url(#hubglow)" stroke="url(#hubwire)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="58 200">
          {paths.map((d, i) => (
            <path d={d} pathLength="100" style={`animation-delay:${delayFor(i)}s`} />
          ))}
        </g>

        <g class="int-hub-flow int-hub-filament" stroke="#eaf7ff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="58 200">
          {paths.map((d, i) => (
            <path d={d} pathLength="100" style={`animation-delay:${delayFor(i)}s`} />
          ))}
        </g>

      </svg>

      <div class="int-hub-core">
        <img src="/assets/agency-logo/insert ai logo svg black bk.svg" alt="InsertAI" width="200" height="100" class="h-[100px] w-auto -my-9" />
      </div>

      {groupNodes.map((n, i) => (
        <div class={`grp-slot pop-${n.side}`} style={`left:${n.left}%;top:${n.top}%;animation-delay:${i * 0.4}s`} tabindex="0">
          <div class="grp-node">
            <span class="grp-glow" style={`animation-delay:${glowDelayFor(i)}s`}></span>
            <!-- the card taking the charge: fires on the same clock as the
                 wire that feeds it, so the box lights as the pulse lands -->
            <span class="grp-zap" style={`animation-delay:${glowDelayFor(i)}s`}></span>
            <div class="grp-icons">
              {n.icons.map((it) => <img src={it.src} alt="" width="28" height="26" loading="lazy" decoding="async" />)}
              {n.more > 0 && <span class="grp-more">+{n.more}</span>}
            </div>
            <span class="grp-label">{n.label}</span>
          </div>

          <div class="grp-pop">
            <p class="grp-pop-title">{n.label}<span>{n.all.length} tools</span></p>
            <div class="grp-pop-grid">
              {n.all.map((it) => (
                <span class="grp-pop-cell" title={it.name}>
                  <img src={it.src} alt={it.name} width="30" height="28" loading="lazy" decoding="async" />
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
</div>

<style>
  /* container-type is what lets everything inside size itself against the hub's
     own width rather than the viewport. The hub was drawn at 780px with 160px
     cards; dropped into the hero's right column it gets ~620-700px, and with
     the cards still a fixed 160 they crowd the ring and the wire ends stop
     lining up with the boxes. Sizing them in cqw holds every ratio the wire
     geometry assumes, at whatever width the column happens to be.

     Each cqw rule is preceded by its px equivalent at 780px, so a browser
     without container query units drops the cqw line and keeps the original
     fixed size rather than collapsing to auto. */
  .int-hub {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 780px;
    aspect-ratio: 900 / 720;
    margin: 0 auto;
  }
  .int-hub-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* ── current ── */
  /* the unlit conductor. Kept very dark: bright enough that the six routes
     read as a wired ring at rest, dim enough that the travelling charge is
     still clearly the thing moving. */
  .int-hub-rail path { stroke: rgba(120, 140, 220, 0.075); }

  /* the halo is what sells it as charge rather than a coloured dash - it is
     the same stroke blurred wide underneath the filament */
  .int-hub-halo path { opacity: 0.75; }

  /* the filament flickers as it travels. Irregular stops, and no flicker at
     all across the middle of the run, so it reads as an unsteady contact
     rather than a strobe. The animation-delay set inline applies to both the
     travel and the flicker, which is what keeps the six wires out of phase
     with each other. */
  .int-hub-filament path {
    animation: hub-flow 9s linear infinite, hub-flicker 1.1s linear infinite;
  }
  @keyframes hub-flicker {
    0%, 30%, 62%, 100% { opacity: 1; }
    12% { opacity: 0.55; }
    18% { opacity: 0.92; }
    74% { opacity: 0.66; }
  }

  /* The card taking the charge. Inset shadows only - .grp-node clips its
     overflow, so an outer glow would be cut off at the border; lighting the
     inside edge reads as the box energising anyway.

     Sits at z-index 1: above the ripple, below the icons and label, so the
     flash rims the card without washing out the logos. */
  .grp-zap {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      inset 0 0 0 1px rgba(46, 214, 255, 0.85),
      inset 0 0 20px rgba(46, 214, 255, 0.4),
      inset 0 0 44px rgba(114, 94, 255, 0.35);
    animation: grp-zap 9s linear infinite;
  }
  /* hits hard and drains, rather than fading symmetrically in and out - that
     is the difference between a strike and a pulse */
  @keyframes grp-zap {
    0%, 100% { opacity: 0; }
    2% { opacity: 1; }
    5% { opacity: 0.62; }
    15% { opacity: 0; }
  }

  /* one comet segment per wire, following the bends smoothly, hub -> card.
     head reaches the card at 54% of the cycle, tail at 77%. */
  .int-hub-flow path {
    animation: hub-flow 9s linear infinite;
  }
  /* comet crosses during the first 45% of the cycle, then parks off-path
     (invisible) so only one wave of comets is travelling at a time. */
  @keyframes hub-flow {
    0% { stroke-dashoffset: 58; }
    45%, 100% { stroke-dashoffset: -158; }
  }


  /* central InsertAI pill (fully opaque) */
  .int-hub-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    height: 80px;
    height: 10.26cqw;
    padding: 0 14px;
    padding: 0 1.79cqw;
    border-radius: 999px;
    background: linear-gradient(135deg, #1c2650, #0b0f1e);
    border: 1px solid rgba(46, 214, 255, 0.35);
    box-shadow: 0 0 0 7px rgba(103, 92, 255, 0.1), 0 0 34px rgba(103, 92, 255, 0.5);
    animation: hub-pulse 3s ease-in-out infinite;
    z-index: 2;
  }
  .int-hub-core img { height: 100px; width: auto; margin: -36px 0; }
  .int-hub-core img { height: 12.82cqw; margin: -4.62cqw 0; }
  @keyframes hub-pulse {
    0%, 100% { box-shadow: 0 0 0 7px rgba(103, 92, 255, 0.1), 0 0 30px rgba(103, 92, 255, 0.42); }
    50% { box-shadow: 0 0 0 15px rgba(103, 92, 255, 0), 0 0 50px rgba(46, 214, 255, 0.58); }
  }

  /* category cluster nodes.
     The slot owns the ring position and the float, so the card can keep
     overflow:hidden (it clips the glow wash) while the popup, a sibling,
     escapes the card box. */
  .grp-slot {
    position: absolute;
    /* 160, not 138: at 138 the longer labels ("Ops, Data & Automation",
       "Accounting & Finance") wrapped onto two lines in the real display font,
       so cards ended up different heights and the ring looked uneven. */
    width: 160px;
    width: 20.51cqw;
    transform: translate(-50%, -50%);
    animation: hub-float 4.5s ease-in-out infinite;
    z-index: 3;
  }
  /* hovering a card lifts it over its neighbours and stills the float, so the
     pointer does not have to chase a drifting target into the popup */
  .grp-slot:hover,
  .grp-slot:focus-visible { z-index: 20; animation-play-state: paused; }
  .grp-slot:focus { outline: none; }

  .grp-node {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    gap: 1.13cqw;
    padding: 0.85rem 0.7rem;
    padding: 1.74cqw 1.44cqw;
    border-radius: 16px;
    border-radius: 2.05cqw;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.9), rgba(8, 11, 24, 0.94));
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .grp-slot:hover .grp-node,
  .grp-slot:focus-visible .grp-node {
    border-color: rgba(46, 214, 255, 0.5);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 22px rgba(103, 92, 255, 0.4);
  }

  /* full tool list, revealed on hover */
  .grp-pop {
    position: absolute;
    width: 300px;
    padding: 0.8rem 0.85rem 0.9rem;
    border-radius: 16px;
    border: 1px solid rgba(46, 214, 255, 0.28);
    background: linear-gradient(150deg, rgba(21, 28, 56, 0.98), rgba(7, 10, 22, 0.99));
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.62), 0 0 30px rgba(103, 92, 255, 0.22);
    backdrop-filter: blur(14px);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.94);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 30;
  }
  /* transparent bridge across the 10px gap, so sliding the pointer from the
     card into the panel does not pass through un-hovered space and close it */
  .grp-pop::before { content: ""; position: absolute; left: 0; right: 0; height: 14px; }

  .grp-slot.pop-down-center .grp-pop,
  .grp-slot.pop-down-left .grp-pop,
  .grp-slot.pop-down-right .grp-pop { top: calc(100% + 10px); transform-origin: top center; }
  .grp-slot.pop-down-center .grp-pop::before,
  .grp-slot.pop-down-left .grp-pop::before,
  .grp-slot.pop-down-right .grp-pop::before { top: -14px; }

  .grp-slot.pop-up-center .grp-pop,
  .grp-slot.pop-up-left .grp-pop,
  .grp-slot.pop-up-right .grp-pop { bottom: calc(100% + 10px); transform-origin: bottom center; }
  .grp-slot.pop-up-center .grp-pop::before,
  .grp-slot.pop-up-left .grp-pop::before,
  .grp-slot.pop-up-right .grp-pop::before { bottom: -14px; }

  .grp-slot.pop-down-center .grp-pop,
  .grp-slot.pop-up-center .grp-pop { left: 50%; margin-left: -150px; }
  .grp-slot.pop-down-left .grp-pop,
  .grp-slot.pop-up-left .grp-pop { left: 0; }
  .grp-slot.pop-down-right .grp-pop,
  .grp-slot.pop-up-right .grp-pop { right: 0; }

  .grp-slot:hover .grp-pop,
  .grp-slot:focus-visible .grp-pop,
  .grp-pop:hover {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .grp-pop-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
  }
  .grp-pop-title span { font-size: 10px; font-weight: 600; color: var(--color-acc-2); }

  .grp-pop-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; }
  .grp-pop-cell {
    display: grid;
    place-items: center;
    height: 42px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.035);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .grp-pop-cell:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(46, 214, 255, 0.4);
    transform: translateY(-2px);
  }
  .grp-pop-cell img { height: 22px; width: auto; max-width: 26px; object-fit: contain; }

  /* even colour wash filling the whole card; plain opacity fade (no circle),
     synced to the comet: in as its head enters, out as its tail enters. */
  .grp-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(46, 214, 255, 0.32), rgba(110, 92, 255, 0.32));
    opacity: 0;
    animation: grp-ripple 9s linear infinite;
  }
  /* Fires at the very start of its cycle, because the delay it is given is
     already the arrival time - so the card is lit for the ~1.1s the charge
     spends entering it and is dark the rest of the 9s.

     It used to open at 22% and close at 45%, roughly 2.0-4.1s after its delay.
     Stacked on a delay that was itself 2.2s late, the card ended up glowing
     around 6s after its own pulse had passed, with nothing on the wire to
     explain it. */
  @keyframes grp-ripple {
    0% { opacity: 0; }
    2% { opacity: 1; }
    12% { opacity: 0.85; }
    19% { opacity: 0; }
    100% { opacity: 0; }
  }

  .grp-icons { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.55rem; }
  .grp-icons { gap: 1.13cqw; }
  .grp-icons img { height: 26px; width: auto; max-width: 28px; object-fit: contain; }
  .grp-icons img { height: 3.33cqw; max-width: 3.59cqw; }
  .grp-more { font-size: 11px; font-weight: 700; color: var(--color-acc-2); }
  .grp-more { font-size: 1.41cqw; }
  .grp-label {
    position: relative;
    z-index: 2;
    font-size: 11px;
    font-size: 1.41cqw;
