---
import fs from "node:fs";
import { logoGroups } from "../data/logos";

const listSlugs = (dir) =>
  new Set(
    fs.existsSync(dir)
      ? fs.readdirSync(dir).filter((f) => f.endsWith(".svg")).map((f) => f.slice(0, -4))
      : [],
  );
const colorSet = listSlugs("public/assets/logos-color");
const colorFor = (slug) => (colorSet.has(slug) ? `/assets/logos-color/${slug}.svg` : undefined);

// Layout lives in a 900x720 viewBox that shares the hub container's aspect
// ratio (uniform scale). Cards are placed by %, and each wire is an orthogonal
// path with rounded bends that docks at the centre of the card's facing border.
const positions = [
  { left: 50.00, top: 9.72 },  // top
  { left: 77.91, top: 29.86 }, // upper-right
  { left: 22.09, top: 29.86 }, // upper-left
  { left: 77.91, top: 70.14 }, // lower-right
  { left: 22.09, top: 70.14 }, // lower-left
  { left: 50.00, top: 90.28 }, // bottom
];

/* All six cards sit on a circle of radius 290 around the hub at (450,360),
   spaced every 60 degrees, so every card centre is exactly equidistant from
   it. The viewBox is 900x720 because the old 582 height capped the radius at
   ~248 and left the cards crowding the hub.

   Wires are orthogonal L-routes, not straight radial spokes. Spokes docked
   hub-edge to card-edge and came out 150-201 units, which made the comets
   short and stubby, and every one left from the same ring. These leave from
   six distinct points on the pill's top and bottom edges and all land within
   198-201 units, so the comets read at a consistent length. */
const wires = [
  [[450, 314], [450, 113]],              // top
  [[510, 314], [510, 215], [609, 215]],  // upper-right
  [[390, 314], [390, 215], [291, 215]],  // upper-left
  [[510, 406], [510, 505], [609, 505]],  // lower-right
  [[390, 406], [390, 505], [291, 505]],  // lower-left
  [[450, 406], [450, 607]],              // bottom
];

// Build an SVG path of orthogonal segments with rounded corners.
function roundedPath(pts, r) {
  const dist = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]) || 1;
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const p0 = pts[i - 1], p1 = pts[i], p2 = pts[i + 1];
    const d1 = dist(p0, p1), d2 = dist(p1, p2);
    const rr = Math.min(r, d1 / 2, d2 / 2);
    const ax = p1[0] + ((p0[0] - p1[0]) / d1) * rr;
    const ay = p1[1] + ((p0[1] - p1[1]) / d1) * rr;
    const bx = p1[0] + ((p2[0] - p1[0]) / d2) * rr;
    const by = p1[1] + ((p2[1] - p1[1]) / d2) * rr;
    d += ` L${ax.toFixed(1)} ${ay.toFixed(1)} Q${p1[0]} ${p1[1]} ${bx.toFixed(1)} ${by.toFixed(1)}`;
  }
  const l = pts[pts.length - 1];
  d += ` L${l[0]} ${l[1]}`;
  return d;
}
const paths = wires.map((w) => roundedPath(w, 22));

// Two waves per cycle: the upper three fire, then the lower three.
const delayFor = (i) => (i < 3 ? 0 : 4.5);

const groupNodes = logoGroups.map((g, i) => ({
  label: g.label,
  icons: g.items.map((it) => colorFor(it.slug)).filter(Boolean).slice(0, 3),
  more: Math.max(0, g.items.length - 3),
  ...positions[i],
}));
---

<section id="integrations" class="py-5">
  <div class="site-shell">
    <div class="text-center">
      <p class="mono text-[--color-acc]">Integrations</p>
      <!-- deliberately not inside a max-w-2xl wrapper: at 3rem this headline
           needs ~900px and was wrapping to two lines inside 672px. -->
      <h2 class="display mt-4 text-[clamp(2rem,4vw,3rem)]">Plugs into the tools you <span class="accent">already use.</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-[--color-fg-muted]">
        Connect with 200+ popular business tools and platforms - data flows automatically across everything you run.
      </p>
    </div>

    <div class="int-hub" aria-hidden="true">
      <svg class="int-hub-wires" viewBox="0 0 900 720" fill="none">
        <defs>
          <!-- userSpaceOnUse, not the default objectBoundingBox: a perfectly
               vertical path has a zero-width bounding box, which collapses an
               objectBoundingBox gradient and renders the stroke invisible.
               That is why the top and bottom wires vanished while the diagonals
               drew fine. Fixed coordinates over the viewBox avoid it. -->
          <linearGradient id="hubwire" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="900" y2="720">
            <stop offset="0" stop-color="#1ed6ff" />
            <stop offset="1" stop-color="#7b5cff" />
          </linearGradient>
        </defs>
        <!-- only the moving comet is drawn; the connecting track stays invisible -->
        <g class="int-hub-flow" stroke="url(#hubwire)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="58 200">
          {paths.map((d, i) => (
            <path
              d={d}
              pathLength="100"
              style={`animation-delay:${delayFor(i)}s`}
            />
          ))}
        </g>
      </svg>

      <div class="int-hub-core">
        <img src="/assets/agency-logo/insert ai logo svg black bk.svg" alt="InsertAI" width="200" height="100" class="h-[100px] w-auto -my-9" />
      </div>

      {groupNodes.map((n, i) => (
        <div class="grp-node" style={`left:${n.left}%;top:${n.top}%;animation-delay:${i * 0.4}s`}>
          <span class="grp-glow" style={`animation-delay:${i === 5 ? 0 : (i < 2 ? 0 : 7)}s`}></span>
          <div class="grp-icons">
            {n.icons.map((u) => <img src={u} alt="" width="28" height="26" loading="lazy" decoding="async" />)}
            {n.more > 0 && <span class="grp-more">+{n.more}</span>}
          </div>
          <span class="grp-label">{n.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .int-hub {
    position: relative;
    width: 100%;
    max-width: 780px;
    aspect-ratio: 900 / 720;
    margin: 3rem auto 0;
  }
  .int-hub-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* one comet segment per wire, following the bends smoothly, hub -> card.
     head reaches the card at 54% of the cycle, tail at 77%. */
  .int-hub-flow path {
    animation: hub-flow 9s linear infinite;
  }
  /* comet crosses during the first 45% of the cycle, then parks off-path
     (invisible) so only one wave of comets is travelling at a time. */
  @keyframes hub-flow {
    0% { stroke-dashoffset: 58; }
    45%, 100% { stroke-dashoffset: -158; }
  }


  /* central InsertAI pill (fully opaque) */
  .int-hub-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    height: 80px;
    padding: 0 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, #1c2650, #0b0f1e);
    border: 1px solid rgba(46, 214, 255, 0.35);
    box-shadow: 0 0 0 7px rgba(103, 92, 255, 0.1), 0 0 34px rgba(103, 92, 255, 0.5);
    animation: hub-pulse 3s ease-in-out infinite;
    z-index: 2;
  }
  .int-hub-core img { height: 100px; width: auto; margin: -36px 0; }
  @keyframes hub-pulse {
    0%, 100% { box-shadow: 0 0 0 7px rgba(103, 92, 255, 0.1), 0 0 30px rgba(103, 92, 255, 0.42); }
    50% { box-shadow: 0 0 0 15px rgba(103, 92, 255, 0), 0 0 50px rgba(46, 214, 255, 0.58); }
  }

  /* category cluster nodes */
  .grp-node {
    position: absolute;
    overflow: hidden;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    /* 160, not 138: at 138 the longer labels ("Ops, Data & Automation",
       "Accounting & Finance") wrapped onto two lines in the real display font,
       so cards ended up different heights and the ring looked uneven. */
    width: 160px;
    padding: 0.85rem 0.7rem;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.9), rgba(8, 11, 24, 0.94));
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    animation: hub-float 4.5s ease-in-out infinite;
    z-index: 3;
  }

  /* even colour wash filling the whole card; plain opacity fade (no circle),
     synced to the comet: in as its head enters, out as its tail enters. */
  .grp-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(46, 214, 255, 0.32), rgba(110, 92, 255, 0.32));
    opacity: 0;
    animation: grp-ripple 9s linear infinite;
  }
  @keyframes grp-ripple {
    0%, 22% { opacity: 0; }
    28% { opacity: 1; }
    35% { opacity: 1; }
    45% { opacity: 0; }
    100% { opacity: 0; }
  }

  .grp-icons { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.55rem; }
  .grp-icons img { height: 26px; width: auto; max-width: 28px; object-fit: contain; }
  .grp-more { font-size: 11px; font-weight: 700; color: var(--color-acc-2); }
  .grp-label {
    position: relative;
    z-index: 2;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
  }
  @keyframes hub-float {
    0%, 100% { transform: translate(-50%, -50%); }
    50% { transform: translate(-50%, -54%); }
  }

  @media (max-width: 640px) {
    .int-hub { max-width: 420px; }
    .grp-node { width: 124px; padding: 0.6rem 0.5rem; gap: 0.4rem; border-radius: 13px; }
    .grp-icons { gap: 0.4rem; }
    .grp-icons img { height: 20px; max-width: 22px; }
    .grp-more { font-size: 10px; }
    .grp-label { font-size: 9.5px; }
    .int-hub-core { height: 60px; padding: 0 10px; }
    .int-hub-core img { height: 80px; margin: -28px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .int-hub-flow path, .int-hub-core, .grp-node, .grp-glow { animation: none; }
    .grp-glow { opacity: 0; }
  }
</style>
