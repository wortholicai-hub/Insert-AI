      <div>
        <p class="mono mb-4 text-white">Services</p>
        <ul class="space-y-3 text-sm text-white/58">
          <li><a class="link-sweep hover:text-white" href="#services">AI Agents & Voice AI</a></li>
          <li><a class="link-sweep hover:text-white" href="#services">Custom Software & SaaS</a></li>
          <li><a class="link-sweep hover:text-white" href="#services">Automation & CRM</a></li>
          <li><a class="link-sweep hover:text-white" href="#services">RAG & Knowledge Systems</a></li>
        </ul>
      </div>

      <div>
        <p class="mono mb-4 text-white">Company</p>
        <ul class="space-y-3 text-sm text-white/58">
          <li><a class="link-sweep hover:text-white" href="#about">About Us</a></li>
          <li><a class="link-sweep hover:text-white" href="#process">Careers</a></li>
          <li><a class="link-sweep hover:text-white" href={`mailto:${site.email}`}>Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="mono mb-4 text-white">Resources</p>
        <ul class="space-y-3 text-sm text-white/58">
          <li><a class="link-sweep hover:text-white" href="#work">Case Studies</a></li>
          <li><a class="link-sweep hover:text-white" href="#insights">Blog</a></li>
          <li><button class="link-sweep hover:text-white cursor-pointer" type="button" data-legal="guides">Guides</button></li>
        </ul>
      </div>

      <div>
        <p class="mono mb-4 text-white">Stay inspired</p>
        <p class="text-sm leading-6 text-white/55">Get ideas, trends, and proven strategies in your inbox.</p>
        <form class="mt-5 flex overflow-hidden rounded-xl border border-white/12 bg-white/[0.03]">
          <input type="email" placeholder="Enter your email" class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm text-white outline-none placeholder:text-white/35" />
          <button class="grid w-12 place-items-center bg-[--color-acc] text-sm font-bold text-white" type="submit" aria-label="Subscribe">→</button>
        </form>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-5 text-xs text-white/36 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-8">
        <button class="hover:text-white/70 cursor-pointer" type="button" data-legal="privacy">Privacy Policy</button>
        <button class="hover:text-white/70 cursor-pointer" type="button" data-legal="terms">Terms of Service</button>
      </div>
    </div>
  </div>
</footer>

<!-- Legal Popup Modal -->
<div id="legalModal" class="legal-overlay" aria-hidden="true">
  <div class="legal-modal">
    <div class="legal-header">
      <h3 id="legalTitle" class="legal-title"></h3>
      <button class="legal-close" type="button" aria-label="Close">&times;</button>
    </div>
    <div id="legalBody" class="legal-body"></div>
  </div>
</div>

<style is:global>
  .legal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .legal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .legal-modal {
    position: relative;
    width: 90%;
    max-width: 680px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(150deg, rgba(19, 25, 50, 0.97), rgba(5, 7, 16, 0.98));
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(103, 92, 255, 0.12);
    transform: translateY(20px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .legal-overlay.is-open .legal-modal {
    transform: translateY(0) scale(1);
  }
  .legal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .legal-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
  }
  .legal-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-size: 1.3rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .legal-close:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .legal-body {
    padding: 1.5rem;
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.65);
  }
  .legal-intro {
    padding: 1.25rem 1.5rem;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(114, 94, 255, 0.12), rgba(78, 115, 255, 0.08));
    border: 1px solid rgba(114, 94, 255, 0.15);
  }
  .legal-intro p {
    margin: 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }
  .legal-intro .legal-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.5rem;
    border-radius: 6px;
    background: linear-gradient(135deg, #725eff, #4e73ff);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: white;
  }
  .legal-section {
    position: relative;
    padding: 1.25rem 1.5rem;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .legal-section:hover {
    border-color: rgba(114, 94, 255, 0.2);
    background: rgba(114, 94, 255, 0.04);
  }
  .legal-section-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
  }
  .legal-section-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(135deg, #725eff, #4e73ff);
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
  }
  .legal-section-title {
    font-size: 0.92rem;
    font-weight: 650;
    color: rgba(255, 255, 255, 0.92);
  }
  .legal-body p {
    margin-bottom: 0.6rem;
  }
  .legal-body ul {
    margin: 0.4rem 0 0.75rem 0;
    padding: 0;
    list-style: none;
  }
  .legal-body li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .legal-body li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: linear-gradient(135deg, #725eff, #4e73ff);
  }
  .legal-footer-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }
  .legal-footer-note span {
    color: rgba(114, 94, 255, 0.8);
  }
  .legal-body::-webkit-scrollbar {
    width: 6px;
  }
  .legal-body::-webkit-scrollbar-track {
    background: rgba(103, 92, 255, 0.06);
    border-radius: 10px;
  }
  .legal-body::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #725eff, #4e73ff);
    border-radius: 10px;
  }
  .legal-body::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #8a74ff, #6488ff);
  }
  .legal-body {
    scrollbar-color: #725eff rgba(103, 92, 255, 0.06);
    scrollbar-width: thin;
  }
</style>

<script>
(function () {
  const overlay = document.getElementById('legalModal');
  const title = document.getElementById('legalTitle');
  const body = document.getElementById('legalBody');
  const closeBtn = overlay?.querySelector('.legal-close');
  if (!overlay || !title || !body) return;

  const content: Record<string, { title: string; html: string }> = {
    privacy: {
      title: 'Privacy Policy',
      html: `
        <div class="legal-intro">
