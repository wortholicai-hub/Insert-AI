---
import { site } from "../data/site";
const year = 2023;
---

<footer class="pb-10 pt-6">
  <div class="site-shell">
    <div class="grid gap-10 border-t border-white/10 pt-8 md:grid-cols-[1.4fr_1fr_1fr_1fr_1.2fr]">
      <div>
        <a href="#top" class="flex items-center text-white" aria-label={site.name}>
          <img src="/assets/agency-logo/insert ai logo svg black bk.svg" alt={`${site.name} logo`} class="h-[100px] w-auto -my-9" />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-6 text-white/55">
          We insert AI into your business and build the software that makes it real. Custom AI, automation, and software engineering for companies at every stage.
        </p>
        <div class="mt-5 flex gap-2">
          <a href="https://www.linkedin.com/company/insert-artificial-intelligence/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid h-8 w-8 place-items-center rounded-full border border-white/10 text-white/60 transition hover:border-white/30 hover:text-white">
