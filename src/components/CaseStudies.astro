// Most media entries are just a path. An entry that points at something we have
// actually shipped is an object instead, carrying the outbound link and its own
// alt text. Normalising here keeps the markup below indifferent to which it is.
const asMedia = (m) =>
  typeof m === "string" ? { src: m, href: null, label: null, alt: null } : m;
---

<!-- ============ "The Systems We Engineer" interactive capabilities ============ -->
<section id="case-studies" class="spec-section">
  <div class="site-shell">
    <p class="mono text-[--color-acc]">Capabilities</p>
    <h2 class="spec-title display">The Systems We <span class="accent">Engineer.</span></h2>

    <div class="spec-body">
      <!-- Service list + CTAs column -->
      <div>
        <ul class="spec-services" id="specServices">
          {capabilities.map((c, i) => (
            <li>
              <button
                class:list={["spec-item", { "is-active": i === 0 }]}
                data-index={i}
                type="button"
              >
                <span class="spec-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="spec-text">
                  <span class="spec-name">{c.title}</span>
                  <span class="spec-desc">{c.desc}</span>
                </span>
                <svg class="spec-arrow" viewBox="0 0 256 256" aria-hidden="true" fill="currentColor">
                  <path d="M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z" />
                </svg>
              </button>
            </li>
          ))}
        </ul>

        <div class="mt-4 flex flex-wrap gap-3">
          <a href="#contact" class="btn-primary px-6 py-3.5">
            Book a Free Consultation
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Media panel — each service group has multiple stacked images -->
      <div class="spec-media" id="specMedia">
        {capabilities.map((c, gi) => (
          <div
            class:list={["spec-group", { "is-active": gi === 0 }]}
            data-group={gi}
          >
            {c.media.map(asMedia).map((m, si) => (
              <>
                <img
                  src={m.src}
                  alt={m.alt || `${c.title} - ${c.desc} Screenshot ${si + 1}`}
                  width="1200"
                  height="800"
                  draggable="false"
                  loading={gi === 0 && si === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={gi === 0 && si === 0 ? "high" : "auto"}
                  class:list={["spec-frame", { "is-visible": si === 0 }]}
                  data-frame={si}
                  style="image-rendering: -webkit-optimize-contrast;"
                />
                {/* Must stay the image's immediate next sibling: the badge is
                    shown by `.spec-frame.is-visible + .spec-cta`, which ties it
                    to the frame cycling without touching the slideshow script. */}
                {m.href && (
                  <a class="spec-cta" href={m.href} target="_blank" rel="noopener noreferrer">
                    {m.label}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                  </a>
                )}
              </>
            ))}
            <!-- progress dots -->
            <div class="spec-dots">
              {c.media.map((_, si) => (
                <span class:list={["spec-dot", { "is-current": si === 0 }]} />
              ))}
            </div>
          </div>
        ))}
        <!-- Navigation arrows -->
        <button class="spec-nav spec-nav--prev" type="button" aria-label="Previous image">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="spec-nav spec-nav--next" type="button" aria-label="Next image">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  /* ---- We Specialize In section ---- */
  .spec-section {
    padding: 3rem 0;
  }

  .spec-title {
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .spec-body {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 3rem;
    align-items: start;
  }

  .spec-services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    width: 100%;
    padding: 0.4rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--color-fg-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.45;
    transition:
      background 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-item.is-active {
    background: linear-gradient(135deg, rgba(103, 92, 255, 0.35), rgba(30, 214, 255, 0.12));
    border-color: rgba(103, 92, 255, 0.4);
    color: var(--color-fg);
    opacity: 1;
  }

  .spec-item:hover:not(.is-active) {
    opacity: 0.7;
    background: rgba(255, 255, 255, 0.03);
  }

  .spec-item:focus-visible {
    outline: 2px solid var(--color-acc);
    outline-offset: 2px;
  }

  .spec-num {
    flex: 0 0 auto;
    padding-top: 2px;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .spec-item.is-active .spec-num {
    color: var(--color-acc-2);
    opacity: 1;
  }

  .spec-text { flex: 1 1 auto; min-width: 0; }

  .spec-name {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .spec-desc {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: 0.72;
  }

  .spec-arrow {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    margin-top: 4px;
    transform: translateX(-6px);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-item.is-active .spec-arrow {
    transform: translateX(0);
    opacity: 1;
    color: #fff;
  }

  /* ---- Media panel ---- */
  .spec-media {
    position: sticky;
    top: 6rem;
    isolation: isolate;
    border-radius: 0;
    overflow: hidden;
    border: none;
    background: transparent;
    aspect-ratio: 9 / 6;
  }

  /* Each service's image group */
  .spec-group {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-group.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Individual frames within a group */
  .spec-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.08) translateX(30px);
    filter: blur(6px) brightness(0.7);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .spec-frame.is-visible {
    opacity: 1;
    transform: scale(1) translateX(0);
    filter: blur(0) brightness(1);
  }

  .spec-frame.is-exiting {
    opacity: 0;
    transform: scale(0.95) translateX(-30px);
    filter: blur(4px) brightness(0.6);
  }

  /* Shimmer sweep overlay on frame change */
  .spec-group::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(103, 92, 255, 0.18) 42%,
      rgba(30, 214, 255, 0.22) 50%,
      rgba(103, 92, 255, 0.18) 58%,
      transparent 70%
    );
    opacity: 0;
    transform: translateX(-120%);
    transition: none;
  }

  .spec-group.splash::after {
    opacity: 1;
    transform: translateX(120%);
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.15s ease;
  }

  /* Live-site link, sitting on the frame it belongs to and visible the whole
     time that frame is up - it was hover-only, which combined with the ~1s
     frame cycle made it effectively impossible to find.

     Bottom-right: the dots own bottom-centre, the arrows own the mid sides,
     and these screenshots put their own titles in the lower left. */
  .spec-cta {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(6, 8, 18, 0.72);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, background 0.2s ease, border-color 0.2s ease,
      transform 0.2s ease;
  }
  .spec-cta svg { width: 12px; height: 12px; opacity: 0.8; }
  .spec-frame.is-visible + .spec-cta {
    opacity: 1;
    pointer-events: auto;
  }
  .spec-cta:hover {
    background: linear-gradient(135deg, #725eff, #4e73ff);
    border-color: transparent;
    transform: translateY(-1px);
  }
  .spec-cta:hover {
    background: linear-gradient(135deg, #725eff, #4e73ff);
    border-color: transparent;
  }

  /* Navigation arrows */
  .spec-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    color: white;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.25s ease;
  }
  .spec-nav svg {
    width: 18px;
    height: 18px;
  }
  .spec-media:hover .spec-nav {
    opacity: 1;
  }
  .spec-nav:hover {
    background: linear-gradient(135deg, #725eff, #4e73ff);
    border-color: transparent;
    transform: translateY(-50%) scale(1.1);
  }
  .spec-nav--prev { left: 12px; }
  .spec-nav--next { right: 12px; }

  /* Progress dots */
  .spec-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 6px;
  }

  .spec-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .spec-dot.is-current {
    background: #fff;
    transform: scale(1.3);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .spec-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .spec-media {
      position: static;
      order: -1;
    }
    .spec-item { padding: 0.85rem 1rem; }
    .spec-name { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spec-item, .spec-arrow, .spec-frame, .spec-group {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
(function () {
  const list  = document.getElementById('specServices');
  const media = document.getElementById('specMedia');
  if (!list || !media) return;

  const items  = list.querySelectorAll('.spec-item');
  const groups = media.querySelectorAll('.spec-group');
  const prevBtn = media.querySelector('.spec-nav--prev');
  const nextBtn = media.querySelector('.spec-nav--next');
  const count  = groups.length;

  let currentGroup = 0;
  let activeFrames: number[] = new Array(count).fill(0);
  let cycleTimer: ReturnType<typeof setInterval> | null = null;
  const CYCLE_MS = 1000;

  function stopCycle() {
    if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = null; }
  }

  function switchFrame(groupIndex: number, direction: number) {
    const group = groups[groupIndex];
    const frames = group.querySelectorAll('.spec-frame');
    const dots   = group.querySelectorAll('.spec-dot');
    if (frames.length <= 1) return;

    const prev = activeFrames[groupIndex];

    // exit animation
    frames[prev].classList.add('is-exiting');
    frames[prev].classList.remove('is-visible');
    dots[prev].classList.remove('is-current');

    // advance or go back
    activeFrames[groupIndex] = (prev + direction + frames.length) % frames.length;
    const next = activeFrames[groupIndex];

    // shimmer sweep
    group.classList.remove('splash');
    void (group as HTMLElement).offsetWidth;
    group.classList.add('splash');
    setTimeout(() => group.classList.remove('splash'), 650);

    // show next
    frames[next].classList.add('is-visible');
    dots[next].classList.add('is-current');

    // clean up exit class
    setTimeout(() => frames[prev].classList.remove('is-exiting'), 500);
  }

  function startCycle(groupIndex: number) {
    stopCycle();
    const group = groups[groupIndex];
    const frames = group.querySelectorAll('.spec-frame');
    if (frames.length <= 1) return;

    cycleTimer = setInterval(() => {
      switchFrame(groupIndex, 1);
    }, CYCLE_MS);
  }

  function activate(index: number) {
    if (index === currentGroup || index < 0 || index >= count) return;

    // reset previous group's frames to first image
    const prevGroup = groups[currentGroup];
    const prevFrames = prevGroup.querySelectorAll('.spec-frame');
    const prevDots   = prevGroup.querySelectorAll('.spec-dot');
    prevFrames.forEach((f, i) => f.classList.toggle('is-visible', i === 0));
    prevDots.forEach((d, i) => d.classList.toggle('is-current', i === 0));
    activeFrames[currentGroup] = 0;

    currentGroup = index;

    // toggle service list active state
    items.forEach((el, i) => el.classList.toggle('is-active', i === index));

    // toggle media group
    groups.forEach((g, i) => g.classList.toggle('is-active', i === index));

    // restart the image cycle for the new group
    startCycle(index);
  }

  // Left/right nav buttons
  prevBtn?.addEventListener('click', () => {
    stopCycle();
    switchFrame(currentGroup, -1);
  });
  nextBtn?.addEventListener('click', () => {
    stopCycle();
    switchFrame(currentGroup, 1);
  });

  items.forEach((el) => {
    const index = parseInt((el as HTMLElement).dataset.index || '0', 10);
    el.addEventListener('mouseenter', () => activate(index));
    el.addEventListener('focus', () => activate(index));
    el.addEventListener('click', (e) => {
      if (window.matchMedia('(hover: none)').matches && currentGroup !== index) {
        e.preventDefault();
        activate(index);
      }
    });
  });

  // pause cycling when hovering over the media panel
  media.addEventListener('mouseenter', () => stopCycle());
  media.addEventListener('mouseleave', () => startCycle(currentGroup));

  // start cycling on the first group
  startCycle(0);
})();
</script>
